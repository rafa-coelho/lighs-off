@inherits LayoutComponentBase

<div class="min-h-screen flex">
    <aside class="hidden md:flex md:flex-col w-60 border-r border-zinc-800/80 bg-zinc-950/60 backdrop-blur sticky top-0 h-screen">
        <div class="h-14 flex items-center px-5 border-b border-zinc-800/80">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.8)]"></div>
                <span class="font-semibold tracking-tight">lights-off</span>
            </div>
        </div>
        <div class="flex-1 overflow-y-auto py-3">
            <NavMenu />
        </div>
        <div class="px-5 py-3 border-t border-zinc-800/80 text-xs text-zinc-500">
            <div>Local dev tool</div>
            <div class="text-zinc-600">~/.lightsoff</div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0">
        <header class="h-14 md:hidden border-b border-zinc-800 flex items-center px-4 gap-2">
            <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
            <span class="font-semibold">lights-off</span>
        </header>
        <div class="flex-1 overflow-y-auto">
            <div class="max-w-6xl mx-auto px-6 py-8">
                @Body
            </div>
        </div>
    </main>
</div>

<ToastHost />
