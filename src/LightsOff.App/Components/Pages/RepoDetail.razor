@page "/repos/{RepoName}"
@using LightsOff.Core.Configuration
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject IRepositoryRegistry Registry
@inject ICodeAgentProvider AgentProvider
@inject LightsOff.Infrastructure.Data.AppDbContext Db
@inject IOptions<LightsOffOptions> OptionsAccessor
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@RepoName</PageTitle>

<nav class="flex items-center gap-2 text-sm text-zinc-500 mb-4">
    <a href="/repos" class="hover:text-zinc-200 inline-flex items-center gap-1.5">
        <Icon Name="arrow-left" Class="w-4 h-4" /> Repositories
    </a>
    <span class="text-zinc-700">/</span>
    <span class="text-zinc-300">@RepoName</span>
</nav>

@if (_repo is null && !_loading)
{
    <Alert Kind="Alert.AlertKind.Warning">Repository <code>@RepoName</code> not found.</Alert>
}
else if (_repo is null)
{
    <div class="flex items-center gap-3 text-sm text-zinc-500 py-12 justify-center"><Spinner /> Loading…</div>
}
else
{
    <!-- Header -->
    <div class="flex items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
            <div class="flex items-center gap-3 mb-1">
                <div class="w-10 h-10 rounded-xl bg-zinc-800 flex items-center justify-center">
                    <Icon Name="folder" Class="w-5 h-5 text-zinc-400" />
                </div>
                <div>
                    <h1 class="text-2xl font-semibold tracking-tight">@_repo.Name</h1>
                    <code class="text-xs text-zinc-500 font-mono">@_repo.DefaultBranch</code>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
            <button type="button" @onclick="BeginEdit"
                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md border border-zinc-800 hover:bg-zinc-800/60 text-zinc-200 text-sm font-medium transition-colors">
                <Icon Name="settings" Class="w-4 h-4" /> Edit
            </button>
            <button type="button" @onclick="DeleteAsync" disabled="@_busy"
                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md border border-red-900/70 hover:bg-red-950/40 text-red-300 text-sm font-medium transition-colors disabled:opacity-50">
                <Icon Name="trash" Class="w-4 h-4" /> Delete
            </button>
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-5">
        <!-- Clone info -->
        <section class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5">
            <h2 class="text-sm font-semibold mb-4">Clone</h2>
            <dl class="space-y-3 text-sm">
                <div>
                    <dt class="text-xs uppercase tracking-wider text-zinc-500">URL</dt>
                    <dd class="text-zinc-300 font-mono text-xs mt-0.5 break-all">@_repo.CloneUrl</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wider text-zinc-500">Default branch</dt>
                    <dd class="text-zinc-300 font-mono text-xs mt-0.5">@_repo.DefaultBranch</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wider text-zinc-500">Container image</dt>
                    <dd class="text-zinc-300 font-mono text-xs mt-0.5">@(_repo.Image ?? "(global default)")</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wider text-zinc-500">Local path</dt>
                    <dd class="text-zinc-400 font-mono text-[10px] mt-0.5 break-all">@Path.Combine(OptionsAccessor.Value.ReposRoot, _repo.Name)</dd>
                </div>
            </dl>
        </section>

        <!-- Dependencies (editable) -->
        <section class="lg:col-span-2 rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold">Dependencies</h2>
                <button type="button" @onclick="DetectDepsAsync" disabled="@_detecting"
                        class="text-xs text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-1 disabled:opacity-40">
                    @if (_detecting) { <Spinner Class="w-3 h-3" /> } else { <Icon Name="refresh" Class="w-3 h-3" /> }
                    @(_profile is null ? "Auto-detect" : "Re-detect")
                </button>
            </div>
            @if (_profile is null)
            {
                <div class="text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-lg px-4 py-6 text-center">
                    Not detected yet. Click Auto-detect or create a workspace.
                </div>
            }
            else
            {
                <div class="grid md:grid-cols-2 gap-5">
                    <!-- Runtimes -->
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Runtimes</label>
                            <button type="button" @onclick="@(async () => { _profile.Runtimes.Add(new RuntimeRequirement("node", "20", null)); await SaveProfileAsync(); await InvokeAsync(StateHasChanged); })"
                                    class="text-[10px] text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-0.5">
                                <Icon Name="plus" Class="w-2.5 h-2.5" /> Add
                            </button>
                        </div>
                        <div class="space-y-1.5">
                            @for (var i = 0; i < _profile.Runtimes.Count; i++)
                            {
                                var idx = i;
                                var rt = _profile.Runtimes[idx];
                                <div class="flex items-center gap-1.5 group/rt">
                                    <select value="@rt.Runtime" @onchange="@(async e => { _profile.Runtimes[idx] = rt with { Runtime = (string?)e.Value ?? "node" }; await SaveProfileAsync(); })"
                                            class="bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs w-20 focus:outline-none focus:ring-1 focus:ring-emerald-500/40">
                                        @foreach (var r in LightsOff.Infrastructure.Agents.RuntimeInstaller.SupportedRuntimes)
                                        { <option value="@r" selected="@(r == rt.Runtime)">@r</option> }
                                    </select>
                                    <input value="@rt.Version" @onchange="@(async e => { _profile.Runtimes[idx] = rt with { Version = (string?)e.Value ?? "latest" }; await SaveProfileAsync(); })"
                                           class="bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono w-16 focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                    <input value="@rt.SubPath" @onchange="@(async e => { _profile.Runtimes[idx] = rt with { SubPath = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() }; await SaveProfileAsync(); })"
                                           placeholder="subpath"
                                           class="bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono flex-1 placeholder:text-zinc-700 focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                    <button type="button" @onclick="@(async () => { _profile.Runtimes.RemoveAt(idx); await SaveProfileAsync(); await InvokeAsync(StateHasChanged); })"
                                            class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/rt:opacity-100 transition-all">
                                        <Icon Name="x" Class="w-3 h-3" />
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Package install + custom -->
                    <div class="space-y-4">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Package install</label>
                                <button type="button" @onclick="@(async () => { _profile.PackageInstallCommands.Add(""); await InvokeAsync(StateHasChanged); })"
                                        class="text-[10px] text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-0.5">
                                    <Icon Name="plus" Class="w-2.5 h-2.5" /> Add
                                </button>
                            </div>
                            <div class="space-y-1">
                                @for (var i = 0; i < _profile.PackageInstallCommands.Count; i++)
                                {
                                    var idx = i;
                                    <div class="flex items-center gap-1.5 group/pkg">
                                        <code class="text-zinc-700 text-[10px]">$</code>
                                        <input value="@_profile.PackageInstallCommands[idx]"
                                               @onchange="@(async e => { _profile.PackageInstallCommands[idx] = (string?)e.Value ?? ""; await SaveProfileAsync(); })"
                                               class="flex-1 bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                        <button type="button" @onclick="@(async () => { _profile.PackageInstallCommands.RemoveAt(idx); await SaveProfileAsync(); await InvokeAsync(StateHasChanged); })"
                                                class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/pkg:opacity-100 transition-all">
                                            <Icon Name="x" Class="w-3 h-3" />
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Custom commands</label>
                                <button type="button" @onclick="@(async () => { _profile.CustomCommands.Add(""); await InvokeAsync(StateHasChanged); })"
                                        class="text-[10px] text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-0.5">
                                    <Icon Name="plus" Class="w-2.5 h-2.5" /> Add
                                </button>
                            </div>
                            <div class="space-y-1">
                                @for (var i = 0; i < _profile.CustomCommands.Count; i++)
                                {
                                    var idx = i;
                                    <div class="flex items-center gap-1.5 group/cust">
                                        <code class="text-zinc-700 text-[10px]">$</code>
                                        <input value="@_profile.CustomCommands[idx]"
                                               @onchange="@(async e => { _profile.CustomCommands[idx] = (string?)e.Value ?? ""; await SaveProfileAsync(); })"
                                               placeholder="apt-get install -y redis-tools"
                                               class="flex-1 bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono placeholder:text-zinc-700 focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                        <button type="button" @onclick="@(async () => { _profile.CustomCommands.RemoveAt(idx); await SaveProfileAsync(); await InvokeAsync(StateHasChanged); })"
                                                class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/cust:opacity-100 transition-all">
                                            <Icon Name="x" Class="w-3 h-3" />
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-[10px] text-zinc-600 mt-3 pt-2 border-t border-zinc-800/60">
                    Detected @_profile.DetectedAt.ToLocalTime().ToString("g") by @_profile.AgentUsed · changes auto-saved
                </div>
            }
        </section>
    </div>

    <!-- Test configs (editable, full width) -->
    <div class="mt-5">
        <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold">Test configs</h2>
                <button type="button" @onclick="AddTestConfig"
                        class="inline-flex items-center gap-1.5 h-7 px-3 rounded-md text-xs text-zinc-400 hover:text-zinc-100 border border-zinc-800 hover:bg-zinc-800/60 transition-colors">
                    <Icon Name="plus" Class="w-3 h-3" /> Add test
                </button>
            </div>
            @if (_testConfigs.Count == 0)
            {
                <div class="text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-lg px-4 py-6 text-center">
                    No tests configured. Add one, or they'll be auto-detected from the tech stack on workspace creation.
                </div>
            }
            else
            {
                <div class="grid md:grid-cols-2 gap-3">
                    @foreach (var tc in _testConfigs)
                    {
                        var commands = (tc.Command ?? "").Split('\n', StringSplitOptions.TrimEntries).ToList();
                        <div class="rounded-lg border border-zinc-800 bg-zinc-950/40 p-4 group/tc">
                            <div class="flex items-start justify-between gap-2 mb-3">
                                <input value="@tc.Name" @onchange="@(async e => { tc.Name = (string?)e.Value ?? ""; await SaveTestConfigAsync(tc); })"
                                       class="bg-transparent text-sm font-semibold text-zinc-200 border-none focus:outline-none flex-1 min-w-0 placeholder:text-zinc-600" placeholder="Test name" />
                                <button type="button" @onclick="@(async () => { _testConfigs.Remove(tc); Db.RepoTestConfigs.Remove(tc); await Db.SaveChangesAsync(); await InvokeAsync(StateHasChanged); })"
                                        class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/tc:opacity-100 transition-all flex-shrink-0">
                                    <Icon Name="trash" Class="w-3.5 h-3.5" />
                                </button>
                            </div>

                            <div class="space-y-2">
                                <div>
                                    <label class="block text-[10px] uppercase tracking-wider text-zinc-600 mb-1">Working directory</label>
                                    <input value="@tc.WorkingDir" @onchange="@(async e => { tc.WorkingDir = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim(); await SaveTestConfigAsync(tc); })"
                                           placeholder="(repo root)"
                                           class="w-full bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono placeholder:text-zinc-700 focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                </div>
                                <div>
                                    <label class="block text-[10px] uppercase tracking-wider text-zinc-600 mb-1">Commands</label>
                                    <div class="space-y-1">
                                        @for (var ci = 0; ci < commands.Count; ci++)
                                        {
                                            var cmdIdx = ci;
                                            <div class="flex items-center gap-1.5 group/cmd">
                                                <code class="text-zinc-700 text-[10px]">$</code>
                                                <input value="@commands[cmdIdx]"
                                                       @onchange="@(async e => { commands[cmdIdx] = (string?)e.Value ?? ""; tc.Command = string.Join('\n', commands); await SaveTestConfigAsync(tc); })"
                                                       class="flex-1 bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                                @if (commands.Count > 1)
                                                {
                                                    <button type="button" @onclick="@(async () => { commands.RemoveAt(cmdIdx); tc.Command = string.Join('\n', commands); await SaveTestConfigAsync(tc); await InvokeAsync(StateHasChanged); })"
                                                            class="p-0.5 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/cmd:opacity-100 transition-all">
                                                        <Icon Name="x" Class="w-3 h-3" />
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <button type="button" @onclick="@(async () => { tc.Command = (tc.Command ?? "") + "\n"; await InvokeAsync(StateHasChanged); })"
                                            class="mt-1.5 w-full flex items-center justify-center gap-1 h-7 rounded border border-dashed border-zinc-800 text-[10px] text-zinc-600 hover:text-zinc-300 hover:border-zinc-600 transition-colors">
                                        <Icon Name="plus" Class="w-2.5 h-2.5" /> Add command
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Workspaces using this repo -->
    @if (_linkedWorkspaces.Count > 0)
    {
        <div class="mt-6">
            <h2 class="text-sm font-semibold mb-3">Workspaces using this repo</h2>
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var w in _linkedWorkspaces)
                {
                    <a href="@($"/workspaces/{w.TicketKey}")"
                       class="rounded-lg border border-zinc-800 bg-zinc-950/40 hover:bg-zinc-900/40 hover:border-zinc-700 transition-colors p-3 flex items-center gap-3">
                        <div class="w-2 h-2 rounded-full flex-shrink-0 @(w.Status == WorkspaceStatus.Running ? "bg-emerald-400" : "bg-zinc-600")"></div>
                        <div class="min-w-0">
                            <code class="text-sm text-emerald-400 font-medium">@w.TicketKey</code>
                            <div class="text-xs text-zinc-500 truncate">@w.TicketSummary</div>
                        </div>
                        <Icon Name="chevron-right" Class="w-4 h-4 text-zinc-700 ml-auto" />
                    </a>
                }
            </div>
        </div>
    }
}

<!-- Edit modal -->
<Modal @bind-Open="_editOpen" Title="Edit repository">
    <ChildContent>
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Clone URL</label>
                <input @bind="_editForm.CloneUrl"
                       class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm font-mono text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1.5">Default branch</label>
                    <input @bind="_editForm.DefaultBranch"
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm font-mono text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1.5">Image <span class="text-zinc-600">(optional)</span></label>
                    <input @bind="_editForm.Image" placeholder="node:20"
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm font-mono text-xs placeholder:text-zinc-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors" />
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" @onclick="() => _editOpen = false"
                class="inline-flex items-center gap-2 h-9 px-4 rounded-md text-sm text-zinc-300 hover:text-zinc-50 hover:bg-zinc-800/50 transition-colors">Cancel</button>
        <button type="button" @onclick="SaveEditAsync" disabled="@_busy"
                class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors disabled:opacity-50">
            <Icon Name="check" Class="w-4 h-4" /> Save
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public string RepoName { get; set; } = string.Empty;

    private Repository? _repo;
    private RepoDependencyProfile? _profile;
    private List<RepoTestConfig> _testConfigs = new();
    private List<Workspace> _linkedWorkspaces = new();
    private bool _loading = true;
    private bool _busy;
    private bool _detecting;
    private bool _editOpen;
    private Repository _editForm = new();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _repo = await Registry.GetAsync(RepoName);
        if (_repo is not null)
        {
            var store = new LightsOff.Infrastructure.Data.DependencyProfileStore(Db);
            _profile = await store.LoadAsync(RepoName);
            _testConfigs = await Db.RepoTestConfigs
                .Where(c => c.RepositoryName == RepoName)
                .OrderBy(c => c.Order)
                .ToListAsync();
            _linkedWorkspaces = await Db.Workspaces
                .Include(w => w.Links)
                .Where(w => w.Links.Any(l => l.RepositoryName == RepoName))
                .OrderByDescending(w => w.CreatedAt)
                .ToListAsync();
        }
        _loading = false;
    }

    private void BeginEdit()
    {
        if (_repo is null) return;
        _editForm = new Repository
        {
            Name = _repo.Name,
            CloneUrl = _repo.CloneUrl,
            DefaultBranch = _repo.DefaultBranch,
            Image = _repo.Image
        };
        _editOpen = true;
    }

    private async Task SaveEditAsync()
    {
        _busy = true;
        try
        {
            await Registry.UpdateAsync(_editForm);
            Toasts.Success("Updated.");
            _editOpen = false;
            _repo = await Registry.GetAsync(RepoName);
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            await Registry.RemoveAsync(RepoName);
            Toasts.Info($"Removed {RepoName}.");
            Nav.NavigateTo("/repos");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task SaveProfileAsync()
    {
        if (_profile is null) return;
        try
        {
            var store = new LightsOff.Infrastructure.Data.DependencyProfileStore(Db);
            await store.SaveAsync(_profile);
        }
        catch { /* best-effort auto-save */ }
    }

    private async Task SaveTestConfigAsync(RepoTestConfig tc)
    {
        try { Db.RepoTestConfigs.Update(tc); await Db.SaveChangesAsync(); }
        catch { /* tolerate concurrent edits */ }
    }

    private async Task AddTestConfig()
    {
        var order = _testConfigs.Count > 0 ? _testConfigs.Max(t => t.Order) + 1 : 1;
        var tc = new RepoTestConfig
        {
            RepositoryName = RepoName,
            Name = "New test",
            Command = "",
            Order = order
        };
        Db.RepoTestConfigs.Add(tc);
        await Db.SaveChangesAsync();
        _testConfigs.Add(tc);
    }

    private async Task DetectDepsAsync()
    {
        _detecting = true;
        try
        {
            var repoPath = Path.Combine(OptionsAccessor.Value.ReposRoot, RepoName);
            if (!Directory.Exists(repoPath)) { Toasts.Warning("Repo not cloned yet. Create a workspace first."); return; }
            var agent = AgentProvider.GetDefaultAgent();
            _profile = await agent.DetectDependenciesAsync(repoPath);
            var store = new LightsOff.Infrastructure.Data.DependencyProfileStore(Db);
            await store.SaveAsync(_profile);
            Toasts.Success($"Detected: {string.Join(", ", _profile.Runtimes.Select(r => $"{r.Runtime}:{r.Version}"))}");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _detecting = false; }
    }
}
