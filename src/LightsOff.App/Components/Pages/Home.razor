@page "/"

<PageTitle>lights-off</PageTitle>

<div class="space-y-2 mb-10">
    <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-zinc-500">
        <div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div>
        Dashboard
    </div>
    <h1 class="text-3xl font-semibold tracking-tight">lights-off</h1>
    <p class="text-zinc-400 max-w-2xl">Jira-driven multi-repo workspace orchestrator. Pick a ticket, pick repos, get a pre-branched dev container.</p>
</div>

<div class="grid md:grid-cols-2 gap-5">
    <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-6">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-base font-semibold">Getting started</h2>
            <span class="text-xs text-zinc-500">4 steps</span>
        </div>
        <ol class="space-y-2">
            @foreach (var (num, label, href, icon) in _steps)
            {
                <li>
                    <a href="@href" class="group flex items-center gap-3 -mx-2 px-3 py-2 rounded-md hover:bg-zinc-800/50 transition-colors">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-zinc-800 text-xs font-semibold text-zinc-400 group-hover:bg-emerald-500/10 group-hover:text-emerald-400 transition-colors">@num</span>
                        <Icon Name="@icon" Class="w-4 h-4 text-zinc-500 group-hover:text-zinc-300" />
                        <span class="text-sm text-zinc-300 group-hover:text-zinc-50 flex-1">@label</span>
                        <Icon Name="chevron-right" Class="w-4 h-4 text-zinc-700 group-hover:text-zinc-500" />
                    </a>
                </li>
            }
        </ol>
    </div>

    <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-6">
        <h2 class="text-base font-semibold mb-5">Quick links</h2>
        <div class="grid grid-cols-2 gap-3">
            <a href="/workspaces" class="rounded-lg border border-zinc-800 bg-zinc-950/60 hover:border-zinc-700 hover:bg-zinc-900/60 transition-colors p-4">
                <Icon Name="terminal" Class="w-5 h-5 text-emerald-400 mb-3" />
                <div class="text-sm font-medium">Workspaces</div>
                <div class="text-xs text-zinc-500 mt-1">Running containers</div>
            </a>
            <a href="/tickets" class="rounded-lg border border-zinc-800 bg-zinc-950/60 hover:border-zinc-700 hover:bg-zinc-900/60 transition-colors p-4">
                <Icon Name="ticket" Class="w-5 h-5 text-sky-400 mb-3" />
                <div class="text-sm font-medium">Tickets</div>
                <div class="text-xs text-zinc-500 mt-1">From active board</div>
            </a>
            <a href="/repos" class="rounded-lg border border-zinc-800 bg-zinc-950/60 hover:border-zinc-700 hover:bg-zinc-900/60 transition-colors p-4">
                <Icon Name="folder" Class="w-5 h-5 text-amber-400 mb-3" />
                <div class="text-sm font-medium">Repositories</div>
                <div class="text-xs text-zinc-500 mt-1">Registered repos</div>
            </a>
            <a href="/settings" class="rounded-lg border border-zinc-800 bg-zinc-950/60 hover:border-zinc-700 hover:bg-zinc-900/60 transition-colors p-4">
                <Icon Name="settings" Class="w-5 h-5 text-zinc-400 mb-3" />
                <div class="text-sm font-medium">Settings</div>
                <div class="text-xs text-zinc-500 mt-1">Jira + GitHub</div>
            </a>
        </div>
    </div>
</div>

@code {
    private readonly (int Num, string Label, string Href, string Icon)[] _steps = new[]
    {
        (1, "Configure Jira connection",       "/settings",    "settings"),
        (2, "Add a repository",                "/repos",       "folder"),
        (3, "Pick an active board",            "/boards",      "dashboard"),
        (4, "Open a ticket, create workspace", "/tickets",     "ticket"),
    };
}
