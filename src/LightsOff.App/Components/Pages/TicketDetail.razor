        }

        @if (_workspace?.ContainerName is not null)
        {
            <div class="flex items-center gap-2 mb-4">
                <code class="flex-1 text-xs font-mono text-emerald-300 bg-zinc-950 border border-zinc-800 rounded px-2.5 py-1.5 truncate">
                    docker exec -it @_workspace.ContainerName bash
                </code>
                <button type="button" @onclick="CopyAttachAsync" class="p-1.5 rounded-md text-zinc-500 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" title="Copy">
                    <Icon Name="copy" Class="w-4 h-4" />
                </button>
            </div>
        }

        @if (_changeSummary is not null)
        {
            <div class="rounded-lg border border-zinc-800 bg-zinc-950/40 px-4 py-3 mb-4 text-sm">
                @if (_changeSummary.HasChanges)
                {
                    <div class="text-emerald-300 font-medium mb-1">Changes detected</div>
                    @if (_changeSummary.FilesChanged > 0)
                    {
                        <div class="text-zinc-400 text-xs">@_changeSummary.FilesChanged file(s) committed · <span class="text-emerald-400">+@_changeSummary.Additions</span> <span class="text-red-400">-@_changeSummary.Deletions</span></div>
                    }
                    @if (_changeSummary.HasUncommitted)
                    {
                        <div class="text-amber-300 text-xs mt-1">Uncommitted changes found — remember to <code>git add + commit</code> before submitting PRs.</div>
                    }
                }
                else
                {
                    <div class="text-amber-300 font-medium">No code changes detected.</div>
                    <div class="text-zinc-500 text-xs mt-0.5">Edit files in the repo, then check again. Both uncommitted edits and committed diffs are detected.</div>
                }
            </div>
        }

        <div class="flex gap-2">
            <button type="button" @onclick="CheckChangesAsync" disabled="@_checkingChanges"
                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-zinc-800 hover:bg-zinc-700 text-zinc-100 text-sm font-medium transition-colors disabled:opacity-50">
                @if (_checkingChanges) { <Spinner /> <span>Checking…</span> }
                else { <Icon Name="refresh" Class="w-4 h-4" /> <span>Check for changes</span> }
            </button>
            <button type="button" @onclick="MarkImplementDone"
                    disabled="@(_changeSummary is null or { HasChanges: false })"
                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                <Icon Name="check" Class="w-4 h-4" /> Mark as done
            </button>
        </div>
    };

    private async Task LoadDepProfilesAsync()
    {
        if (_workspace is null) return;
        var store = new LightsOff.Infrastructure.Data.DependencyProfileStore(Db);
        var agent = AgentProvider.GetDefaultAgent();
        foreach (var link in _workspace.Links)
        {
            var profile = await store.LoadAsync(link.RepositoryName);
            if (profile is null)
            {
                // Auto-detect for repos that existed before this feature
                var repoPath = Path.Combine(_options.ReposRoot, link.RepositoryName);
                if (Directory.Exists(repoPath))
                {
                    try
                    {
                        profile = await agent.DetectDependenciesAsync(repoPath);
                        await store.SaveAsync(profile);
                    }
                    catch { }
                }
            }
            if (profile is not null)
            {
                _depProfiles[link.RepositoryName] = profile;
            }
        }
    }

    private async Task SaveDepProfileAsync(RepoDependencyProfile profile)
    {
        var store = new LightsOff.Infrastructure.Data.DependencyProfileStore(Db);
        await store.SaveAsync(profile);
    }

    private async Task ReinstallDepsAsync(RepoDependencyProfile profile)
    {
        if (_workspace?.ContainerId is null) { Toasts.Warning("No container running."); return; }
        _reinstalling = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var script = LightsOff.Infrastructure.Agents.RuntimeInstaller.GenerateInstallScript(profile);
            await Docker.ExecAsync(_workspace.ContainerId, new[] { "sh", "-c", script }, default).ConfigureAwait(false);
            Toasts.Success($"Dependencies installed for {profile.RepositoryName}.");
        }
        catch (Exception ex)
        {
            Toasts.Error($"Install failed: {ex.Message}");
        }
        finally
        {
            _reinstalling = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RedetectDepsAsync(string repoName)
    {
        var repoPath = Path.Combine(_options.ReposRoot, repoName);
        if (!Directory.Exists(repoPath)) return;
        try
        {
            var agent = AgentProvider.GetDefaultAgent();
            var profile = await agent.DetectDependenciesAsync(repoPath);
            _depProfiles[repoName] = profile;
            await SaveDepProfileAsync(profile);
            Toasts.Success($"Re-detected: {string.Join(", ", profile.Runtimes.Select(r => $"{r.Runtime}:{r.Version}"))}");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task CheckChangesAsync()
    {
        if (_workspace is null) return;
        _checkingChanges = true;
        _changeSummary = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var totalFiles = 0; var totalAdds = 0; var totalDels = 0;
            var hasUncommitted = false;

            foreach (var link in _workspace.Links)
            {
                var repo = await Registry.GetAsync(link.RepositoryName);
                var repoPath = Path.Combine(_options.ReposRoot, link.RepositoryName);
                if (!Directory.Exists(repoPath)) continue;

                // Check uncommitted changes (modified/staged files not yet committed)
                if (await Git.HasUncommittedChangesAsync(repoPath))
                {
                    hasUncommitted = true;
                }

                // Check committed diff between default branch and feature branch
                var diff = await Git.GetDiffAsync(repoPath, repo?.DefaultBranch ?? "main", link.BranchName);
                if (!string.IsNullOrWhiteSpace(diff))
                {
                    var lines = diff.Split('\n');
                    totalFiles += lines.Count(l => l.StartsWith("+++ b/"));
                    totalAdds += lines.Count(l => l.StartsWith('+') && !l.StartsWith("+++"));
                    totalDels += lines.Count(l => l.StartsWith('-') && !l.StartsWith("---"));
                }
            }

            var hasChanges = totalFiles > 0 || hasUncommitted;
            _changeSummary = new(hasChanges, totalFiles, totalAdds, totalDels, hasUncommitted);
        }
        catch
        {
            _changeSummary = new(false, 0, 0, 0, false);
        }
        finally
        {
            _checkingChanges = false;
            await SaveWorkflowStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkImplementDone()
    {
        _workflow.Steps[PipelineStep.Implement] = StepStatus.Passed;
        _activeStep = PipelineStep.Validate;
        await SaveWorkflowStateAsync();
    }

    // ── Validate Step — test config CRUD + runners ──────────────────────

    private async Task LoadTestConfigsAsync()
    {
        if (_workspace is null) return;
        var repoNames = _workspace.Links.Select(l => l.RepositoryName).ToList();
        _testConfigs = await Db.RepoTestConfigs
            .Where(c => repoNames.Contains(c.RepositoryName))
            .OrderBy(c => c.RepositoryName).ThenBy(c => c.Order)
            .ToListAsync();

        // Auto-seed from TechStackDetector if no configs exist for a repo
        foreach (var repoName in repoNames)
        {
            if (_testConfigs.Any(c => c.RepositoryName == repoName)) continue;
            var repoPath = Path.Combine(_options.ReposRoot, repoName);
            if (!Directory.Exists(repoPath)) continue;

            var stack = LightsOff.Infrastructure.Agents.TechStackDetector.Detect(repoPath);
            if (stack.TestCommand is null) continue;

            var seed = new RepoTestConfig
            {
                RepositoryName = repoName,
                Name = $"{stack.TestFramework ?? "Tests"}",
                Command = stack.TestCommand,
                Order = 1
            };
            Db.RepoTestConfigs.Add(seed);
            await Db.SaveChangesAsync();
            _testConfigs.Add(seed);
        }
    }

    private static readonly JsonSerializerOptions _jsonOpts = new(JsonSerializerDefaults.Web) { WriteIndented = false };

    private void LoadWorkflowState()
    {
        if (_workspace?.WorkflowStateJson is not null)
        {
            try
            {
                var loaded = JsonSerializer.Deserialize<WorkflowStatePersist>(_workspace.WorkflowStateJson, _jsonOpts);
                if (loaded is not null)
                {
                    if (loaded.Steps is not null)
                    {
                        foreach (var (step, status) in loaded.Steps)
                            _workflow.Steps[step] = status;
                    }
                    _analysis = loaded.Analysis;
                    _workflow.Analysis = _analysis;
                    _plan = loaded.Plan;
                    _workflow.Plan = _plan;
                    _suiteResult = loaded.TestResults;
                    _review = loaded.Review;
                    _submitResults = loaded.SubmitResults;
                    _changeSummary = loaded.Changes;
                    _activeStep = loaded.ActiveStep;

                    // Self-heal stuck states from older code:
                    // 1. Tests passed but Validate was never marked Passed (status updater wasn't
                    //    in OnTestRunUpdated). Promote it now.
                    if (_suiteResult is not null && _suiteResult.AllPassed
                        && _workflow.Steps[PipelineStep.Validate] == StepStatus.Pending)
                    {
                        _workflow.Steps[PipelineStep.Validate] = StepStatus.Passed;
                    }
                    // 2. Submit ran (has results) → user definitely passed through Validate. If
                    //    Validate is still Pending, promote it. Same for Implement.
                    if (_submitResults is { Count: > 0 })
                    {
                        if (_workflow.Steps[PipelineStep.Validate] == StepStatus.Pending)
                            _workflow.Steps[PipelineStep.Validate] = StepStatus.Passed;
                        if (_workflow.Steps[PipelineStep.Implement] == StepStatus.Pending)
                            _workflow.Steps[PipelineStep.Implement] = StepStatus.Passed;
                    }
                    // 3. Review was folded into Validate, so if Validate is Passed/Warning but
                    //    Review is still Pending the user can't reach Submit. Mark it Skipped.
                    if (_workflow.Steps[PipelineStep.Validate] is StepStatus.Passed or StepStatus.Warning
                        && _workflow.Steps[PipelineStep.Review] == StepStatus.Pending)
                    {
                        _workflow.Steps[PipelineStep.Review] = StepStatus.Skipped;
                    }
                }
            }
            catch { /* corrupt JSON — start fresh */ }
        }
    }

    /// <summary>
    /// Called after <see cref="LoadWorkflowState"/>: restores the active question batch ID
    /// if one exists in the conversation, or re-posts analysis questions when the analysis has
    /// error gaps but its conversation was lost (e.g. circuit disconnect before the save).
    /// </summary>
    private async Task RestoreQuestionsStateAsync()
    {
        if (_analysis is null) return;

        bool hasClosedBatch = false;

        // Look for an existing unclosed batch in the conversation.
        for (var i = _analysis.Conversation.Count - 1; i >= 0; i--)
        {
            var att = _analysis.Conversation[i].Attachment;
            if (att is not { Kind: ChatAttachment.KindQuestions, PayloadJson: { } json }) continue;
            try
            {
                var payload = JsonSerializer.Deserialize<QuestionsPayload>(json, _jsonOpts);
                if (payload is { Closed: false })
                {
                    _activeQuestionsBatchId = payload.BatchId;
                    _activeQuestionsPhase = QuestionPhase.Analysis;
                    return;
                }
                if (payload is { Closed: true })
                    hasClosedBatch = true;
            }
            catch { }
        }

        if (_plan is null)
        {
            if (hasClosedBatch)
            {
                // Questions were already answered but plan generation didn't complete.
                // Fire in the background so the page renders immediately.
                _ = InvokeAsync(RetryGeneratePlanAsync);
            }
            else
            {
                // No batch at all — re-post the analysis questions so the user can answer them.
                var questions = ExtractAnalysisQuestions(_analysis);
                if (questions.Count > 0)
                {
                    PostQuestionsToChat(QuestionPhase.Analysis, questions);
                    await SaveWorkflowStateAsync();
                }
            }
        }
    }

    private async Task SaveWorkflowStateAsync()
    {
        if (_workspace is null) return;
        try
        {
            var persist = new WorkflowStatePersist
            {
                Steps = _workflow.Steps,
                Analysis = _analysis,
                Plan = _plan,
                TestResults = _suiteResult,
                Review = _review,
                SubmitResults = _submitResults,
                Changes = _changeSummary,
                ActiveStep = _activeStep
            };
            var json = JsonSerializer.Serialize(persist, _jsonOpts);

            // Update directly via DB to avoid EF tracking issues
            await Db.Database.ExecuteSqlRawAsync(
                """UPDATE "Workspaces" SET "WorkflowStateJson" = {0} WHERE "TicketKey" = {1}""",
                json, _workspace.TicketKey);
        }
        catch { /* best-effort persistence */ }
    }

    private class WorkflowStatePersist
    {
        public Dictionary<PipelineStep, StepStatus>? Steps { get; set; }
        public TicketAnalysis? Analysis { get; set; }
        public ImplementationPlan? Plan { get; set; }
        public TestSuiteResult? TestResults { get; set; }
        public CodeReview? Review { get; set; }
        public IReadOnlyList<PullRequestResult>? SubmitResults { get; set; }
        public ChangeSummary? Changes { get; set; }
        public PipelineStep ActiveStep { get; set; }
    }

    private static List<string> GetCommands(RepoTestConfig config) =>
        (config.Command ?? "").Split('\n', StringSplitOptions.TrimEntries)
        .Where(c => true) // keep empty entries so new fields render before user types
        .ToList();

    private static void SetCommands(RepoTestConfig config, List<string> commands) =>
        config.Command = string.Join('\n', commands);

    private void AddCommand(RepoTestConfig config)
    {
        var cmds = GetCommands(config);
        cmds.Add("");
        SetCommands(config, cmds);
    }

    private void UpdateCommand(RepoTestConfig config, int index, string value)
    {
        var cmds = GetCommands(config);
        if (index >= 0 && index < cmds.Count) cmds[index] = value;
        SetCommands(config, cmds);
    }

    private void RemoveCommand(RepoTestConfig config, int index)
    {
        var cmds = GetCommands(config);
        if (index >= 0 && index < cmds.Count) cmds.RemoveAt(index);
        SetCommands(config, cmds);
    }

    private void ToggleEditTest(int configId)
    {
        _editingTestId = _editingTestId == configId ? null : configId;
    }

    private void AddTestConfig(string repoName)
    {
        var nextOrder = _testConfigs.Where(c => c.RepositoryName == repoName).Select(c => c.Order).DefaultIfEmpty(0).Max() + 1;
        var config = new RepoTestConfig
        {
            RepositoryName = repoName,
            Name = "New test",
            Command = "",
            Order = nextOrder
        };
        Db.RepoTestConfigs.Add(config);
        Db.SaveChanges();
        _testConfigs.Add(config);
        _editingTestId = config.Id; // auto-open edit form for new entries
    }

    private async void SaveTestConfigAsync(RepoTestConfig config)
    {
        try
        {
            Db.RepoTestConfigs.Update(config);
            await Db.SaveChangesAsync();
        }
        catch { /* field-level save, tolerate concurrent edits */ }
    }

    private async void RemoveTestConfig(RepoTestConfig config)
    {
        _testConfigs.Remove(config);
        Db.RepoTestConfigs.Remove(config);
        await Db.SaveChangesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task RunSingleTestAsync(RepoTestConfig config)
    {
        if (_workspace?.ContainerId is null) { Toasts.Warning("No container running."); return Task.CompletedTask; }
        var commands = GetCommands(config).Where(c => !string.IsNullOrWhiteSpace(c)).ToList();
        if (commands.Count == 0) { Toasts.Warning("Add at least one command."); return Task.CompletedTask; }

        TestRunner.StartRun(_workspace.TicketKey, _workspace.ContainerId, new List<RepoTestConfig> { config }, _options.ReposRoot);
        _runningTests = true;
        _workflow.Steps[PipelineStep.Validate] = StepStatus.Running;
        return Task.CompletedTask;
    }

    private Task RunAllTestsAsync()
    {
        if (_workspace?.ContainerId is null) { Toasts.Warning("No container running."); return Task.CompletedTask; }
        if (_testConfigs.Count == 0) return Task.CompletedTask;

        TestRunner.StartRun(_workspace.TicketKey, _workspace.ContainerId, _testConfigs, _options.ReposRoot);
        _runningTests = true;
        _suiteResult = TestRunner.GetActiveRun(_workspace.TicketKey)?.Suite;
        _workflow.Steps[PipelineStep.Validate] = StepStatus.Running;
        return Task.CompletedTask;
    }

    private RenderFragment RenderValidateStep() => __builder =>
    {
        <h3 class="text-sm font-semibold mb-4">Validate (Tests)</h3>

        var validateActive = StepRunner.GetActiveRun(TicketKey) is { Step: PipelineStep.Validate } vr ? vr : null;
        var validateRunIdToShow = validateActive?.StepRunId ?? _lastValidateRunId;
        @if (validateRunIdToShow is not null)
        {
            <div class="mb-6 rounded-lg border border-zinc-800 bg-zinc-950/40 p-4">
                <div class="text-xs font-semibold mb-2 text-zinc-300">Autonomous validation log</div>
                <StepLogViewer TicketKey="@TicketKey" StepRunId="@validateRunIdToShow" />
            </div>
        }

        @if (_workspace?.Links is not null)
        {
            @foreach (var link in _workspace.Links)
            {
                var repoName = link.RepositoryName;
                var configs = _testConfigs.Where(c => c.RepositoryName == repoName).OrderBy(c => c.Order).ToList();

                <div class="mb-6">
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">@repoName</h4>
                        <button type="button" @onclick="@(() => AddTestConfig(repoName))"
                                class="inline-flex items-center gap-1.5 h-7 px-3 rounded-md text-xs text-zinc-400 hover:text-zinc-100 border border-zinc-800 hover:bg-zinc-800/60 transition-colors">
                            <Icon Name="plus" Class="w-3 h-3" /> Add test
                        </button>
                    </div>

                    @if (configs.Count == 0)
                    {
                        <div class="text-xs text-zinc-500 border border-dashed border-zinc-800 rounded-lg px-4 py-6 text-center">
                            No tests configured. Add one to validate your changes.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var config in configs)
                            {
                                var run = _suiteResult?.Results.FirstOrDefault(r => r.ConfigName == config.Name && r.RepositoryName == repoName);
                                <div class="rounded-lg border @(run is null ? "border-zinc-800" : run.AllPassed ? "border-emerald-900/60" : run.HasFailure ? "border-red-900/60" : "border-sky-900/60") bg-zinc-950/60 overflow-hidden">
                                    <!-- Header -->
                                    <div class="flex items-center gap-3 px-4 py-3">
                                        @if (run is not null)
                                        {
                                            @if (run.IsRunning) { <Spinner Class="w-4 h-4 text-sky-400" /> }
                                            else if (run.AllPassed) { <Icon Name="check" Class="w-4 h-4 text-emerald-400" /> }
                                            else { <Icon Name="x" Class="w-4 h-4 text-red-400" /> }
                                        }
                                        else
                                        {
                                            <div class="w-5 h-5 rounded-full bg-zinc-800 flex items-center justify-center">
                                                <span class="text-zinc-500 text-[10px] font-bold">@(configs.IndexOf(config) + 1)</span>
                                            </div>
                                        }
                                        <span class="text-sm font-semibold text-zinc-200 flex-1">@config.Name</span>
                                        @if (!string.IsNullOrEmpty(config.WorkingDir))
                                        {
                                            <span class="text-[10px] text-zinc-600 font-mono">@config.WorkingDir/</span>
                                        }
                                        <button type="button" @onclick="@(() => RunSingleTestAsync(config))"
                                                disabled="@_runningTests"
                                                class="inline-flex items-center gap-1 h-7 px-2.5 rounded-md text-xs text-zinc-400 hover:text-emerald-300 border border-zinc-800 hover:border-emerald-900/60 hover:bg-emerald-950/20 transition-colors disabled:opacity-40">
                                            <Icon Name="play" Class="w-3 h-3" /> Run
                                        </button>
                                        <button type="button" @onclick="@(() => ToggleEditTest(config.Id))"
                                                class="p-1.5 rounded-md text-zinc-600 hover:text-zinc-300 hover:bg-zinc-800 transition-colors">
                                            <Icon Name="settings" Class="w-3.5 h-3.5" />
                                        </button>
                                    </div>

                                    <!-- Steps (GH Actions style) -->
                                    @if (run?.Steps.Count > 0)
                                    {
                                        <div class="border-t border-zinc-800/60">
                                            @foreach (var step in run.Steps)
                                            {
                                                <details class="group/step" open="@(step.Passed == false || step.IsRunning)">
                                                    <summary class="flex items-center gap-2 px-4 py-2 cursor-pointer hover:bg-zinc-900/40 transition-colors text-xs">
                                                        @if (step.IsRunning)
                                                        {
                                                            <Spinner Class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" />
                                                        }
                                                        else if (step.Passed == true)
                                                        {
                                                            <Icon Name="check" Class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" />
                                                        }
                                                        else if (step.Passed == false)
                                                        {
                                                            <Icon Name="x" Class="w-3.5 h-3.5 text-red-400 flex-shrink-0" />
                                                        }
                                                        else
                                                        {
                                                            <div class="w-3.5 h-3.5 rounded-full border border-zinc-700 flex-shrink-0"></div>
                                                        }
                                                        <code class="text-zinc-400 flex-1 truncate">@step.Command</code>
                                                        @if (step.Duration is not null)
                                                        {
                                                            <span class="text-zinc-600 tabular-nums">@step.Duration.Value.TotalSeconds.ToString("F1")s</span>
