    private IReadOnlyList<GitHubRepo> FilteredRepos =>
        _githubRepos is null ? Array.Empty<GitHubRepo>() :
        string.IsNullOrWhiteSpace(_query) ? _githubRepos :
        _githubRepos.Where(r => r.FullName.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task LoadGitHubReposAsync()
    {
        _loadingRepos = true; await InvokeAsync(StateHasChanged);
        try { _githubRepos = await GitHub.ListAccessibleReposAsync(); }
        catch (Exception ex) { _reposError = ex.Message; }
        finally { _loadingRepos = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task CreateWorkspaceAsync()
    {
        if (_ticket is null || _selectedRepos.Count == 0) return;
        _creating = true; _createError = null;
        try
        {
            var existing = (await Registry.ListAsync()).Select(r => r.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var selected = _githubRepos!.Where(r => _selectedRepos.Contains(r.FullName)).ToList();
            foreach (var gh in selected)
            {
                if (!existing.Contains(gh.Name))
                    await Registry.AddAsync(new Repository { Name = gh.Name, CloneUrl = gh.CloneUrl, DefaultBranch = gh.DefaultBranch });
            }
            var request = new CreateWorkspaceRequest(_ticket.Key, _ticket.Summary, selected.Select(r => r.Name).ToList(), _branchName.Trim(), _dockerAvailable == true);
            _workspace = await Workspaces.CreateAsync(request);
            Toasts.Success($"Workspace created for {_ticket.Key}.");
            await RunAnalysisAsync();
        }
        catch (Exception ex) { _createError = ex.InnerException?.Message ?? ex.Message; }
        finally { _creating = false; }
    }

    private async Task CopyAttachAsync()
    {
        if (_workspace?.ContainerName is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"docker exec -it {_workspace.ContainerName} bash"); Toasts.Success("Copied."); }
        catch { Toasts.Info($"docker exec -it {_workspace.ContainerName} bash"); }
    }

    // ── Style helpers ───────────────────────────────────────────────────

    private async void OnTestRunUpdated(string ticketKey)
    {
        if (ticketKey != TicketKey) return;
        var activeRun = TestRunner.GetActiveRun(ticketKey);
        if (activeRun is not null)
        {
            _suiteResult = activeRun.Suite;
            _runningTests = activeRun.IsRunning;
            if (!activeRun.IsRunning)
            {
                _workflow.Steps[PipelineStep.Validate] = _suiteResult.AllPassed ? StepStatus.Passed : StepStatus.Failed;
                // Review was folded into Validate — mark it Skipped so Submit unlocks. Without
                // this Review stays Pending forever and IsStepUnlocked(Submit) returns false.
                if (_suiteResult.AllPassed && _workflow.Steps[PipelineStep.Review] == StepStatus.Pending)
                {
                    _workflow.Steps[PipelineStep.Review] = StepStatus.Skipped;
                }
                // Auto-advance to Submit when validation passes (Review is folded in, so we skip
                // straight to the next actionable step).
                if (_suiteResult.AllPassed && _activeStep == PipelineStep.Validate)
                {
                    _activeStep = PipelineStep.Submit;
                }
                await SaveWorkflowStateAsync();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TestRunner.RunUpdated -= OnTestRunUpdated;
        StepRunner.RunUpdated -= OnStepRunUpdated;
    }

    private PipelineStep? _lastActiveChainStep;

    private async void OnStepRunUpdated(string ticketKey)
    {
        if (ticketKey != TicketKey) return;

        var active = StepRunner.GetActiveRun(TicketKey);
        if (active is not null)
        {
            // Track the latest run-id for each phase so per-step log viewers can replay.
            switch (active.Step)
            {
                case PipelineStep.Implement: _lastImplementRunId = active.StepRunId; break;
                case PipelineStep.Validate:  _lastValidateRunId = active.StepRunId;  break;
                case PipelineStep.Submit:    _lastSubmitRunId = active.StepRunId;    break;
            }

            // Chain transitioned to a new step → mark the previous step Passed (the chain only
            // advances on success). Failures stop the chain before reassigning the active slot.
            if (_lastActiveChainStep is not null && _lastActiveChainStep != active.Step)
            {
                var prev = _lastActiveChainStep.Value;
                if (_workflow.Steps.GetValueOrDefault(prev) == StepStatus.Running)
                    _workflow.Steps[prev] = StepStatus.Passed;
                // Validate was folded into a single UI step — when it passes during the chain,
                // mark Review as Skipped too so Submit can unlock.
                if (prev == PipelineStep.Validate
                    && _workflow.Steps.GetValueOrDefault(PipelineStep.Review) == StepStatus.Pending)
                {
                    _workflow.Steps[PipelineStep.Review] = StepStatus.Skipped;
                }
            }
            _lastActiveChainStep = active.Step;

            if (active.IsRunning)
            {
                _workflow.Steps[active.Step] = StepStatus.Running;
                _activeStep = active.Step;
            }
            else
            {
                // The active run finished (success or failure). Mark its step accordingly so the
                // stepper reflects the terminal state — including the LAST step in a chain (Submit),
                // which never gets a transition event after itself.
                _workflow.Steps[active.Step] = active.Error is null ? StepStatus.Passed : StepStatus.Failed;
                if (active.Step == PipelineStep.Validate && active.Error is null
                    && _workflow.Steps.GetValueOrDefault(PipelineStep.Review) == StepStatus.Pending)
                {
                    _workflow.Steps[PipelineStep.Review] = StepStatus.Skipped;
                }
                _lastActiveChainStep = null;
            }

            await SaveWorkflowStateAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    // ── AI implementation controls ─────────────────────────────────────────

    private string? _lastImplementRunId;
    private string? _lastValidateRunId;
    private string? _lastSubmitRunId;
    private bool _dismissedQualityWarning;

    private async Task LoadTicketAsync()
    {
        if (string.IsNullOrEmpty(TicketKey)) return;
        try
        {
            _ticket = await Jira.GetIssueAsync(TicketKey);
            _dismissedQualityWarning = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toasts.Error($"Refresh failed: {ex.Message}");
        }
    }

    private async Task StartAutonomousChainAsync()
    {
        if (_plan?.IsApproved != true)
        {
            Toasts.Warning("Approve the plan before starting the autonomous run.");
            return;
        }

        var agentId = AgentProvider.GetDefaultAgent().Id;
        var firstRunId = StepRunner.StartAutonomousChain(TicketKey, agentId);
        if (firstRunId is null)
        {
            Toasts.Warning("An AI step is already running for this ticket.");
            return;
        }
        _lastImplementRunId = firstRunId;
        _workflow.Steps[PipelineStep.Implement] = StepStatus.Running;
        _activeStep = PipelineStep.Implement;
        await SaveWorkflowStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartImplementRunAsync()
    {
        if (_plan?.IsApproved != true)
        {
            Toasts.Warning("Approve the plan before running AI implementation.");
            return;
        }

        var agentId = AgentProvider.GetDefaultAgent().Id;
        var runId = StepRunner.StartStep(TicketKey, PipelineStep.Implement, agentId);
        if (runId is null)
        {
            Toasts.Warning("An AI step is already running for this ticket.");
            return;
        }
        _lastImplementRunId = runId;
        _workflow.Steps[PipelineStep.Implement] = StepStatus.Running;
        await SaveWorkflowStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CancelImplementRunAsync()
    {
        await StepRunner.CancelAsync(TicketKey);
        Toasts.Info("Cancel requested. The session will terminate shortly.");
    }

    private static string StatusBadge(string status) =>
        "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border " +
        status.ToLowerInvariant() switch
        {
            var s when s.Contains("done") || s.Contains("closed") => "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
            var s when s.Contains("progress") || s.Contains("review") => "bg-sky-500/10 text-sky-300 border-sky-500/30",
            _ => "bg-zinc-800/70 text-zinc-300 border-zinc-700"
        };

    private static string PlanStatusBadge(PlanStatus status) =>
        "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border " +
        status switch
        {
            PlanStatus.Approved => "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
            PlanStatus.Rejected => "bg-red-500/10 text-red-300 border-red-500/30",
            PlanStatus.ChangesRequested => "bg-amber-500/10 text-amber-300 border-amber-500/30",
            _ => "bg-zinc-800/70 text-zinc-300 border-zinc-700"
        };

    private static string PrStatusBadge(string status) =>
        "text-[10px] uppercase font-medium rounded px-1.5 py-0.5 border " +
        status.ToLowerInvariant() switch
        {
            "open"   => "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
            "merged" => "bg-purple-500/10 text-purple-300 border-purple-500/30",
            "closed" => "bg-zinc-700/40 text-zinc-300 border-zinc-600",
            _        => "bg-zinc-800 text-zinc-400 border-zinc-700"
        };

    private static string CommentBorderColor(PlanCommentType type) => type switch
    {
        PlanCommentType.Approval => "border-emerald-500",
        PlanCommentType.Rejection => "border-red-500",
        PlanCommentType.ChangeRequest => "border-amber-500",
        _ => "border-zinc-700"
    };
}
