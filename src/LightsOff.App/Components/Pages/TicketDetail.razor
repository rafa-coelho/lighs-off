                                    @if (_editingTestId == config.Id)
                                    {
                                        var commands = GetCommands(config);
                                        <div class="px-4 pb-4 space-y-2 border-t border-zinc-800/80 pt-3">
                                            <div>
                                                <label class="block text-[10px] uppercase tracking-wider text-zinc-500 mb-1">Name</label>
                                                <input value="@config.Name" @onchange="@(e => { config.Name = (string?)e.Value ?? ""; })"
                                                       class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-2.5 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-emerald-500/40 transition-colors" />
                                            </div>
                                            <div>
                                                <label class="block text-[10px] uppercase tracking-wider text-zinc-500 mb-1">Working directory</label>
                                                <input value="@config.WorkingDir" @onchange="@(e => { config.WorkingDir = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim(); })"
                                                       placeholder="e.g. apps/backend"
                                                       class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-2.5 py-1.5 text-sm font-mono placeholder:text-zinc-700 focus:outline-none focus:ring-1 focus:ring-emerald-500/40 transition-colors" />
                                            </div>
                                            <div>
                                                <label class="block text-[10px] uppercase tracking-wider text-zinc-500 mb-1">Commands</label>
                                                <div class="space-y-1.5">
                                                    @for (var ci = 0; ci < commands.Count; ci++)
                                                    {
                                                        var cmdIdx = ci;
                                                        <div class="flex items-center gap-1.5 group/cmd">
                                                            <span class="text-zinc-700 text-[10px] font-mono w-4 text-right">@(cmdIdx + 1).</span>
                                                            <input value="@commands[cmdIdx]"
                                                                   @onchange="@(e => UpdateCommand(config, cmdIdx, (string?)e.Value ?? ""))"
                                                                   placeholder="e.g. npm install"
                                                                   class="flex-1 bg-zinc-950 border border-zinc-800 rounded px-2.5 py-1.5 text-xs font-mono placeholder:text-zinc-700 focus:outline-none focus:ring-1 focus:ring-emerald-500/40 transition-colors" />
                                                            @if (commands.Count > 1)
                                                            {
                                                                <button type="button" @onclick="@(async () => { RemoveCommand(config, cmdIdx); await InvokeAsync(StateHasChanged); })"
                                                                        class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/cmd:opacity-100 transition-all">
                                                                    <Icon Name="x" Class="w-3 h-3" />
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <button type="button" @onclick="@(async () => { AddCommand(config); await InvokeAsync(StateHasChanged); })"
                                                        class="mt-2 w-full flex items-center justify-center gap-1.5 h-8 rounded border border-dashed border-zinc-700 text-xs text-zinc-500 hover:text-zinc-200 hover:border-zinc-500 transition-colors">
