@page "/tickets/{TicketKey}"
@using LightsOff.Core.Configuration
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using LightsOff.Core.Utilities
@using Microsoft.Extensions.Options
@inject IJiraClient Jira
@inject IJiraConnectionProvider JiraProvider
@inject IGitHubClient GitHub
@inject IRepositoryRegistry Registry
@inject IWorkspaceManager Workspaces
@inject ICodeAgentProvider AgentProvider
@inject IDockerService Docker
@inject IGitService Git
@inject LightsOff.Infrastructure.Data.AppDbContext Db
@inject IOptions<LightsOffOptions> OptionsAccessor
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@TicketKey</PageTitle>

<nav class="flex items-center gap-2 text-sm text-zinc-500 mb-4">
    <a href="/tickets" class="hover:text-zinc-200 inline-flex items-center gap-1.5">
        <Icon Name="arrow-left" Class="w-4 h-4" /> Tickets
    </a>
    <span class="text-zinc-700">/</span>
    <span class="text-zinc-300"><code>@TicketKey</code></span>
</nav>

@if (_loadState == LoadState.NotConfigured)
{
    <Alert Kind="Alert.AlertKind.Warning">Jira is not configured. <a href="/settings" class="text-amber-100 underline underline-offset-2">Open settings</a>.</Alert>
}
else if (_loadState == LoadState.NotFound)
{
    <Alert Kind="Alert.AlertKind.Warning">Ticket <code>@TicketKey</code> not found.</Alert>
}
else if (_loadState == LoadState.Error)
{
    <Alert Kind="Alert.AlertKind.Error">@_loadError</Alert>
}
else if (_ticket is null)
{
    <div class="flex items-center gap-3 text-sm text-zinc-500 py-12 justify-center"><Spinner /> Loading…</div>
}
else
{
    <!-- Ticket header -->
    <div class="mb-6">
        <div class="flex items-start gap-3 mb-2">
            <code class="text-xl font-semibold text-emerald-400">@_ticket.Key</code>
            <span class="@StatusBadge(_ticket.Status) mt-1.5">@_ticket.Status</span>
        </div>
        <h1 class="text-2xl font-semibold tracking-tight">@_ticket.Summary</h1>
        @if (!string.IsNullOrEmpty(_ticket.Description))
        {
            <div class="mt-3 text-sm text-zinc-400 prose prose-invert prose-sm max-w-none max-h-32 overflow-y-auto border border-zinc-800/80 rounded-lg p-3 bg-zinc-950/40">
                @((MarkupString)(_ticket.Description ?? ""))
            </div>
        }
    </div>

    @if (_workspace is not null)
    {
        <!-- Pipeline view -->
        <PipelineStepper State="_workflow" ActiveStep="_activeStep" OnStepClick="SetActiveStep" />

        <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-6">
            @switch (_activeStep)
            {
                case PipelineStep.Analyze:
                    @RenderAnalyzeStep()
                    break;
                case PipelineStep.Plan:
                    @RenderPlanStep()
                    break;
                case PipelineStep.Implement:
                    @RenderImplementStep()
                    break;
                case PipelineStep.Validate:
                    @RenderValidateStep()
                    break;
                case PipelineStep.Review:
                    @RenderReviewStep()
                    break;
                case PipelineStep.Submit:
                    @RenderSubmitStep()
                    break;
            }
        </div>
    }
    else
    {
        <!-- Workspace creation (same as before but condensed) -->
        @RenderWorkspaceCreation()
    }
}

@code {
    private enum LoadState { Loading, Loaded, NotConfigured, NotFound, Error }

    [Parameter] public string TicketKey { get; set; } = string.Empty;

    private LightsOffOptions _options = new();
    private Ticket? _ticket;
    private Workspace? _workspace;
    private WorkflowState _workflow = new();
    private PipelineStep _activeStep = PipelineStep.Analyze;
    private LoadState _loadState = LoadState.Loading;
    private string? _loadError;
    private bool? _dockerAvailable;

    // Analysis state
    private TicketAnalysis? _analysis;
    private bool _analyzing;

    // Plan state
    private ImplementationPlan? _plan;
    private string _planComment = string.Empty;

    // Validate state
    private List<RepoTestConfig> _testConfigs = new();
    private TestSuiteResult? _suiteResult;
    private bool _runningTests;
    private int? _editingTestId;

    // Review state
    private CodeReview? _review;
    private bool _reviewing;

    // Implement state — dependencies
    private Dictionary<string, RepoDependencyProfile> _depProfiles = new();
    private string? _depEditing;
    private bool _reinstalling;

    // Implement state — changes
    private ChangeSummary? _changeSummary;
    private bool _checkingChanges;

    // Submit state
    private IReadOnlyList<PullRequestResult>? _submitResults;
    private bool _submitting;

    private record ChangeSummary(bool HasChanges, int FilesChanged, int Additions, int Deletions, bool HasUncommitted);

    // Create workspace state
    private IReadOnlyList<GitHubRepo>? _githubRepos;
    private bool _loadingRepos;
    private string? _reposError;
    private string _query = string.Empty;
    private readonly HashSet<string> _selectedRepos = new(StringComparer.OrdinalIgnoreCase);
    private string _branchName = string.Empty;
    private bool _creating;
    private string? _createError;

    protected override async Task OnParametersSetAsync()
    {
        _options = OptionsAccessor.Value;
        _branchName = TextSlug.BuildBranchName(_options.BranchNameTemplate, TicketKey, string.Empty);

        try
        {
            var connection = await JiraProvider.GetAsync();
            if (connection is null) { _loadState = LoadState.NotConfigured; return; }

            _ticket = await Jira.GetIssueAsync(TicketKey);
            _workspace = await Workspaces.GetAsync(TicketKey);
            _dockerAvailable = await Docker.IsDockerAvailableAsync();

            if (_ticket is null) { _loadState = LoadState.NotFound; return; }

            _branchName = TextSlug.BuildBranchName(_options.BranchNameTemplate, _ticket.Key, _ticket.Summary);
            _loadState = LoadState.Loaded;

            if (_workspace is not null)
            {
                LoadWorkflowState();
                await LoadTestConfigsAsync();
                await LoadDepProfilesAsync();
                // Only auto-analyze if no saved state exists (first time opening this ticket)
                if (_workflow.Steps[PipelineStep.Analyze] == StepStatus.Pending)
                {
                    await RunAnalysisAsync();
                }
            }
            else
            {
                _ = LoadGitHubReposAsync();
            }
        }
        catch (Exception ex) { _loadState = LoadState.Error; _loadError = ex.Message; }
    }

    private void SetActiveStep(PipelineStep step)
    {
        if (_workflow.IsStepUnlocked(step))
            _activeStep = step;
    }

    // ── Analyze Step ────────────────────────────────────────────────────

    private async Task RunAnalysisAsync()
    {
        _analyzing = true;
        _analysis = null;
        _plan = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var agent = AgentProvider.GetDefaultAgent();
            var contexts = new List<RepoContext>();
            if (_workspace?.Links is not null)
            {
                foreach (var link in _workspace.Links)
                {
                    var repoPath = Path.Combine(_options.ReposRoot, link.RepositoryName);
                    if (Directory.Exists(repoPath))
                    {
                        try { contexts.Add(await agent.AnalyzeRepositoryAsync(repoPath, ct: default)); }
                        catch { }
                    }
                }
            }
            _analysis = await agent.AnalyzeTicketAsync(_ticket!, contexts);
            _workflow.Analysis = _analysis;
            _workflow.Steps[PipelineStep.Analyze] = _analysis.HasErrors ? StepStatus.Warning : StepStatus.Passed;

            _plan = await agent.GeneratePlanAsync(_ticket!, _analysis, contexts);
            _workflow.Plan = _plan;
            _workflow.Steps[PipelineStep.Plan] = StepStatus.AwaitingApproval;

            Toasts.Success($"Analysis complete: {_analysis.Gaps.Count} finding(s), {_analysis.Tasks.Count} task(s).");
            await SaveWorkflowStateAsync();
        }
        catch (Exception ex)
        {
            _workflow.Steps[PipelineStep.Analyze] = StepStatus.Failed;
            Toasts.Error($"Analysis failed: {ex.Message}");
        }
        finally
        {
            _analyzing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private RenderFragment RenderAnalyzeStep() => __builder =>
    {
        <h3 class="text-sm font-semibold mb-4">Analysis</h3>
        @if (_analyzing)
        {
            <div class="flex items-center gap-3 text-sm text-zinc-500 py-6"><Spinner /> Analyzing ticket + repos…</div>
        }
        else if (_analysis is not null)
        {
            @if (_analysis.Gaps.Count > 0)
            {
                <div class="mb-4 space-y-1.5">
                    @foreach (var gap in _analysis.Gaps)
                    {
                        var (icon, color) = gap.Severity switch
                        {
                            GapSeverity.Error => ("alert", "text-red-400"),
                            GapSeverity.Warning => ("alert", "text-amber-400"),
                            _ => ("info", "text-sky-400")
                        };
                        <div class="flex items-start gap-2 text-sm">
                            <Icon Name="@icon" Class="@($"w-4 h-4 {color} mt-0.5 flex-shrink-0")" />
                            <div>
                                <span class="text-xs uppercase tracking-wider @color font-semibold">@gap.Severity</span>
                                <span class="text-zinc-300 ml-2">@gap.Detail</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-sm text-emerald-300 mb-4 flex items-center gap-2">
                    <Icon Name="check" Class="w-4 h-4" /> No issues found.
                </div>
            }

            @if (_analysis.Tasks.Count > 0)
            {
                <h4 class="text-xs uppercase tracking-wider text-zinc-500 mb-2">Tasks identified</h4>
                <ol class="space-y-1 mb-4">
                    @foreach (var task in _analysis.Tasks)
                    {
                        <li class="flex items-start gap-2 text-sm">
                            <span class="text-zinc-600 font-mono text-xs mt-0.5">@task.Order.</span>
                            <span class="text-zinc-200">@task.Description</span>
                            @if (task.FromTicket) { <span class="text-[10px] text-zinc-500 border border-zinc-700 rounded px-1">from ticket</span> }
                        </li>
                    }
                </ol>
            }

            <button type="button" @onclick="RunAnalysisAsync" class="text-xs text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-1">
                <Icon Name="refresh" Class="w-3 h-3" /> Re-analyze
            </button>
        }
    };

    // ── Plan Step ───────────────────────────────────────────────────────

    private RenderFragment RenderPlanStep() => __builder =>
    {
        <h3 class="text-sm font-semibold mb-4">Implementation Plan</h3>
        @if (_plan is null)
        {
            <div class="text-sm text-zinc-500">Run Analysis first to generate a plan.</div>
        }
        else
        {
            <div class="flex items-center gap-2 mb-4">
                <span class="@PlanStatusBadge(_plan.Status)">@_plan.Status</span>
                <span class="text-xs text-zinc-500">by @_plan.AgentUsed agent</span>
            </div>

            <!-- Editable approach -->
            <div class="mb-4">
                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Approach</label>
                <textarea @bind="_plan.Approach" @bind:event="oninput" rows="3"
                          class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors resize-y"></textarea>
            </div>

            <!-- Editable tasks -->
            <div class="mb-4">
                <div class="flex items-center justify-between mb-2">
                    <label class="text-xs font-medium text-zinc-400 uppercase tracking-wider">Planned tasks</label>
                    <button type="button" @onclick="AddPlanTask"
                            class="text-xs text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-1">
                        <Icon Name="plus" Class="w-3 h-3" /> Add task
                    </button>
                </div>
                <div class="space-y-1.5">
                    @for (var i = 0; i < _plan.Tasks.Count; i++)
                    {
                        var idx = i;
                        var task = _plan.Tasks[idx];
                        <div class="flex items-center gap-2 group">
                            <span class="text-zinc-600 font-mono text-xs w-5 text-right flex-shrink-0">@(idx + 1).</span>
                            <input value="@task.Description"
                                   @onchange="@(e => UpdatePlanTask(idx, (string?)e.Value ?? ""))"
                                   class="flex-1 bg-zinc-950 border border-zinc-800/60 rounded px-2.5 py-1.5 text-sm text-zinc-200 focus:outline-none focus:ring-1 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors" />
                            <button type="button" @onclick="@(() => RemovePlanTask(idx))"
                                    class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all"
                                    title="Remove task">
                                <Icon Name="x" Class="w-3.5 h-3.5" />
                            </button>
                        </div>
                    }
                </div>
            </div>

            @if (_plan.OpenQuestions.Count > 0)
            {
                <h4 class="text-xs uppercase tracking-wider text-red-400 mb-2">Open questions</h4>
                <ul class="space-y-1 mb-4">
                    @foreach (var q in _plan.OpenQuestions)
                    {
                        <li class="text-sm text-red-300 flex items-start gap-2"><Icon Name="alert" Class="w-4 h-4 mt-0.5 flex-shrink-0" /> @q</li>
                    }
                </ul>
            }

            @if (_plan.Comments.Count > 0)
            {
                <h4 class="text-xs uppercase tracking-wider text-zinc-500 mb-2 mt-4">Discussion</h4>
                <div class="space-y-2 mb-4 max-h-48 overflow-y-auto">
                    @foreach (var c in _plan.Comments)
                    {
                        <div class="text-xs border-l-2 @CommentBorderColor(c.Type) pl-3">
                            <span class="font-semibold text-zinc-300">@c.Author</span>
                            <span class="text-zinc-600 ml-2">@c.At.ToLocalTime().ToString("g")</span>
                            <div class="text-zinc-400 mt-0.5">@c.Content</div>
                        </div>
                    }
                </div>
            }

            @if (_plan.NeedsAction)
            {
                <div class="flex flex-col gap-3 pt-4 border-t border-zinc-800/80">
                    <div class="flex gap-2">
                        <input @bind="_planComment" @bind:event="oninput" placeholder="Comment or feedback…"
                               class="flex-1 bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors" />
                    </div>
                    <div class="flex gap-2">
                        <button type="button" @onclick="ApprovePlan"
                                class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors">
                            <Icon Name="check" Class="w-4 h-4" /> Approve
                        </button>
                        <button type="button" @onclick="RequestPlanChanges"
                                class="inline-flex items-center gap-2 h-9 px-4 rounded-md border border-amber-900/70 hover:bg-amber-950/40 text-amber-300 text-sm font-medium transition-colors">
                            Request changes
                        </button>
                        <button type="button" @onclick="RejectPlan"
                                class="inline-flex items-center gap-2 h-9 px-4 rounded-md border border-red-900/70 hover:bg-red-950/40 text-red-300 text-sm font-medium transition-colors">
                            Reject
                        </button>
                    </div>
                </div>
            }
        }
    };

    private async Task ApprovePlan()
    {
        if (_plan is null) return;
        _plan.Status = PlanStatus.Approved;
        _plan.Comments.Add(new PlanComment(DateTimeOffset.UtcNow, "You", PlanCommentType.Approval, string.IsNullOrWhiteSpace(_planComment) ? "Approved." : _planComment));
        _workflow.Steps[PipelineStep.Plan] = StepStatus.Passed;
        _workflow.Steps[PipelineStep.Implement] = StepStatus.Running;
        _planComment = string.Empty;
        _activeStep = PipelineStep.Implement;
        Toasts.Success("Plan approved. Implement step unlocked.");
        await SaveWorkflowStateAsync();
    }

    private async Task RequestPlanChanges()
    {
        if (_plan is null || string.IsNullOrWhiteSpace(_planComment)) { Toasts.Warning("Add your feedback first."); return; }
        _plan.Status = PlanStatus.ChangesRequested;
        _plan.Comments.Add(new PlanComment(DateTimeOffset.UtcNow, "You", PlanCommentType.ChangeRequest, _planComment));
        _workflow.Steps[PipelineStep.Plan] = StepStatus.Warning;
        _planComment = string.Empty;
        await SaveWorkflowStateAsync();
    }

    private void AddPlanTask()
    {
        if (_plan is null) return;
        var nextOrder = _plan.Tasks.Count > 0 ? _plan.Tasks.Max(t => t.Order) + 1 : 1;
        _plan.Tasks.Add(new PlannedTask(nextOrder, "", null, null));
    }

    private void UpdatePlanTask(int index, string description)
    {
        if (_plan is null || index < 0 || index >= _plan.Tasks.Count) return;
        var old = _plan.Tasks[index];
        _plan.Tasks[index] = old with { Description = description };
    }

    private void RemovePlanTask(int index)
    {
        if (_plan is null || index < 0 || index >= _plan.Tasks.Count) return;
        _plan.Tasks.RemoveAt(index);
        // Re-number
        for (var i = 0; i < _plan.Tasks.Count; i++)
        {
            _plan.Tasks[i] = _plan.Tasks[i] with { Order = i + 1 };
        }
    }

    private async Task RejectPlan()
    {
        if (_plan is null) return;
        _plan.Status = PlanStatus.Rejected;
        _plan.Comments.Add(new PlanComment(DateTimeOffset.UtcNow, "You", PlanCommentType.Rejection, string.IsNullOrWhiteSpace(_planComment) ? "Rejected." : _planComment));
        _workflow.Steps[PipelineStep.Plan] = StepStatus.Failed;
        _planComment = string.Empty;
        await SaveWorkflowStateAsync();
    }

    // ── Implement Step ──────────────────────────────────────────────────

    private RenderFragment RenderImplementStep() => __builder =>
    {
        <h3 class="text-sm font-semibold mb-4">Implement</h3>
        <div class="text-sm text-zinc-400 mb-4">Code your changes inside the container. When done, move to Validate.</div>

        <!-- Dependency profiles per repo -->
        @if (_workspace?.Links is not null)
        {
            @foreach (var link in _workspace.Links)
            {
                var repoName = link.RepositoryName;
                _depProfiles.TryGetValue(repoName, out var profile);
                if (profile is not null)
                {
                    <details class="rounded-lg border border-zinc-800 bg-zinc-950/40 mb-4 group/deps" open="@(_depEditing == repoName)">
                        <summary class="px-4 py-3 cursor-pointer flex items-center justify-between text-sm hover:bg-zinc-900/40 transition-colors"
                                 @onclick="@(() => _depEditing = _depEditing == repoName ? null : repoName)">
                            <div class="flex items-center gap-2">
                                <Icon Name="settings" Class="w-4 h-4 text-zinc-500" />
                                <span class="font-medium">@repoName</span>
                                <span class="text-xs text-zinc-500">@string.Join(", ", profile.Runtimes.Select(r => $"{r.Runtime} {r.Version}"))</span>
                            </div>
                            <span class="text-[10px] text-zinc-600">@profile.Runtimes.Count runtime(s)</span>
                        </summary>

                        <div class="px-4 pb-4 space-y-3 border-t border-zinc-800/80 pt-3">
                            <!-- Runtimes -->
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Runtimes</label>
                                    <button type="button" @onclick="@(async () => { profile.Runtimes.Add(new RuntimeRequirement("node", "20", null)); await SaveDepProfileAsync(profile); })"
                                            class="text-[10px] text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-0.5">
                                        <Icon Name="plus" Class="w-2.5 h-2.5" /> Add
                                    </button>
                                </div>
                                @for (var ri = 0; ri < profile.Runtimes.Count; ri++)
                                {
                                    var rIdx = ri;
                                    var rt = profile.Runtimes[rIdx];
                                    <div class="flex items-center gap-2 group/rt">
                                        <select value="@rt.Runtime" @onchange="@(async e => { profile.Runtimes[rIdx] = rt with { Runtime = (string?)e.Value ?? "node" }; await SaveDepProfileAsync(profile); })"
                                                class="bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs w-24 focus:outline-none focus:ring-1 focus:ring-emerald-500/40">
                                            @foreach (var r in LightsOff.Infrastructure.Agents.RuntimeInstaller.SupportedRuntimes)
                                            {
                                                <option value="@r" selected="@(r == rt.Runtime)">@r</option>
                                            }
                                        </select>
                                        <input value="@rt.Version" @onchange="@(async e => { profile.Runtimes[rIdx] = rt with { Version = (string?)e.Value ?? "latest" }; await SaveDepProfileAsync(profile); })"
                                               placeholder="version"
                                               class="bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono w-20 focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                        <input value="@rt.SubPath" @onchange="@(async e => { profile.Runtimes[rIdx] = rt with { SubPath = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() }; await SaveDepProfileAsync(profile); })"
                                               placeholder="subpath (optional)"
                                               class="bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono flex-1 placeholder:text-zinc-700 focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                        <button type="button" @onclick="@(async () => { profile.Runtimes.RemoveAt(rIdx); await SaveDepProfileAsync(profile); await InvokeAsync(StateHasChanged); })"
                                                class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/rt:opacity-100 transition-all">
                                            <Icon Name="x" Class="w-3 h-3" />
                                        </button>
                                    </div>
                                }
                            </div>

                            <!-- Package install commands -->
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Package install</label>
                                    <button type="button" @onclick="@(async () => { profile.PackageInstallCommands.Add(""); await InvokeAsync(StateHasChanged); })"
                                            class="text-[10px] text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-0.5">
                                        <Icon Name="plus" Class="w-2.5 h-2.5" /> Add
                                    </button>
                                </div>
                                @for (var pi = 0; pi < profile.PackageInstallCommands.Count; pi++)
                                {
                                    var pIdx = pi;
                                    <div class="flex items-center gap-1.5 group/pkg">
                                        <code class="text-zinc-700 text-[10px]">$</code>
                                        <input value="@profile.PackageInstallCommands[pIdx]"
                                               @onchange="@(async e => { profile.PackageInstallCommands[pIdx] = (string?)e.Value ?? ""; await SaveDepProfileAsync(profile); })"
                                               class="flex-1 bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                        <button type="button" @onclick="@(async () => { profile.PackageInstallCommands.RemoveAt(pIdx); await SaveDepProfileAsync(profile); await InvokeAsync(StateHasChanged); })"
                                                class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/pkg:opacity-100 transition-all">
                                            <Icon Name="x" Class="w-3 h-3" />
                                        </button>
                                    </div>
                                }
                            </div>

                            <!-- Custom commands -->
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold">Custom commands</label>
                                    <button type="button" @onclick="@(async () => { profile.CustomCommands.Add(""); await InvokeAsync(StateHasChanged); })"
                                            class="text-[10px] text-zinc-500 hover:text-zinc-300 inline-flex items-center gap-0.5">
                                        <Icon Name="plus" Class="w-2.5 h-2.5" /> Add
                                    </button>
                                </div>
                                @for (var ci = 0; ci < profile.CustomCommands.Count; ci++)
                                {
                                    var cIdx = ci;
                                    <div class="flex items-center gap-1.5 group/cust">
                                        <code class="text-zinc-700 text-[10px]">$</code>
                                        <input value="@profile.CustomCommands[cIdx]"
                                               @onchange="@(async e => { profile.CustomCommands[cIdx] = (string?)e.Value ?? ""; await SaveDepProfileAsync(profile); })"
                                               placeholder="apt-get install -y redis-tools"
                                               class="flex-1 bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs font-mono placeholder:text-zinc-700 focus:outline-none focus:ring-1 focus:ring-emerald-500/40" />
                                        <button type="button" @onclick="@(async () => { profile.CustomCommands.RemoveAt(cIdx); await SaveDepProfileAsync(profile); await InvokeAsync(StateHasChanged); })"
                                                class="p-1 rounded text-zinc-700 hover:text-red-400 opacity-0 group-hover/cust:opacity-100 transition-all">
                                            <Icon Name="x" Class="w-3 h-3" />
                                        </button>
                                    </div>
                                }
                                @if (profile.CustomCommands.Count == 0)
                                {
                                    <div class="text-[10px] text-zinc-600">e.g. <code>apt-get install -y redis-tools</code></div>
                                }
                            </div>

                            <div class="flex gap-2 pt-2">
                                <button type="button" @onclick="@(() => ReinstallDepsAsync(profile))" disabled="@_reinstalling"
                                        class="inline-flex items-center gap-1 h-7 px-3 rounded-md text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-100 transition-colors disabled:opacity-50">
                                    @if (_reinstalling) { <Spinner Class="w-3 h-3" /> <span>Installing…</span> }
                                    else { <Icon Name="play" Class="w-3 h-3" /> <span>Reinstall in container</span> }
                                </button>
                                <button type="button" @onclick="@(() => RedetectDepsAsync(repoName))"
                                        class="inline-flex items-center gap-1 h-7 px-3 rounded-md text-xs text-zinc-500 hover:text-zinc-300 border border-zinc-800 hover:bg-zinc-800/60 transition-colors">
                                    <Icon Name="refresh" Class="w-3 h-3" /> Re-detect
                                </button>
                            </div>
                        </div>
                    </details>
                }
            }
        }

        @if (_workspace?.ContainerName is not null)
        {
            <div class="flex items-center gap-2 mb-4">
                <code class="flex-1 text-xs font-mono text-emerald-300 bg-zinc-950 border border-zinc-800 rounded px-2.5 py-1.5 truncate">
                    docker exec -it @_workspace.ContainerName bash
                </code>
                <button type="button" @onclick="CopyAttachAsync" class="p-1.5 rounded-md text-zinc-500 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" title="Copy">
                    <Icon Name="copy" Class="w-4 h-4" />
                </button>
            </div>
        }

        @if (_changeSummary is not null)
        {
            <div class="rounded-lg border border-zinc-800 bg-zinc-950/40 px-4 py-3 mb-4 text-sm">
                @if (_changeSummary.HasChanges)
                {
                    <div class="text-emerald-300 font-medium mb-1">Changes detected</div>
                    @if (_changeSummary.FilesChanged > 0)
                    {
                        <div class="text-zinc-400 text-xs">@_changeSummary.FilesChanged file(s) committed · <span class="text-emerald-400">+@_changeSummary.Additions</span> <span class="text-red-400">-@_changeSummary.Deletions</span></div>
                    }
                    @if (_changeSummary.HasUncommitted)
                    {
                        <div class="text-amber-300 text-xs mt-1">Uncommitted changes found — remember to <code>git add + commit</code> before submitting PRs.</div>
                    }
                }
                else
                {
                    <div class="text-amber-300 font-medium">No code changes detected.</div>
                    <div class="text-zinc-500 text-xs mt-0.5">Edit files in the repo, then check again. Both uncommitted edits and committed diffs are detected.</div>
                }
            </div>
        }

        <div class="flex gap-2">
            <button type="button" @onclick="CheckChangesAsync" disabled="@_checkingChanges"
                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-zinc-800 hover:bg-zinc-700 text-zinc-100 text-sm font-medium transition-colors disabled:opacity-50">
                @if (_checkingChanges) { <Spinner /> <span>Checking…</span> }
                else { <Icon Name="refresh" Class="w-4 h-4" /> <span>Check for changes</span> }
            </button>
            <button type="button" @onclick="MarkImplementDone"
                    disabled="@(_changeSummary is null or { HasChanges: false })"
                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                <Icon Name="check" Class="w-4 h-4" /> Mark as done
            </button>
        </div>
    };

    private async Task LoadDepProfilesAsync()
    {
        if (_workspace is null) return;
        var store = new LightsOff.Infrastructure.Data.DependencyProfileStore(Db);
        foreach (var link in _workspace.Links)
        {
            var profile = await store.LoadAsync(link.RepositoryName);
            if (profile is not null)
            {
                _depProfiles[link.RepositoryName] = profile;
            }
        }
    }

    private async Task SaveDepProfileAsync(RepoDependencyProfile profile)
    {
        var store = new LightsOff.Infrastructure.Data.DependencyProfileStore(Db);
        await store.SaveAsync(profile);
    }

    private async Task ReinstallDepsAsync(RepoDependencyProfile profile)
    {
        if (_workspace?.ContainerId is null) { Toasts.Warning("No container running."); return; }
        _reinstalling = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var script = LightsOff.Infrastructure.Agents.RuntimeInstaller.GenerateInstallScript(profile);
            await Docker.ExecAsync(_workspace.ContainerId, new[] { "sh", "-c", script }, default);
            Toasts.Success($"Dependencies installed for {profile.RepositoryName}.");
        }
        catch (Exception ex)
        {
            Toasts.Error($"Install failed: {ex.Message}");
        }
        finally
        {
            _reinstalling = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RedetectDepsAsync(string repoName)
    {
        var repoPath = Path.Combine(_options.ReposRoot, repoName);
        if (!Directory.Exists(repoPath)) return;
        try
        {
            var agent = AgentProvider.GetDefaultAgent();
            var profile = await agent.DetectDependenciesAsync(repoPath);
            _depProfiles[repoName] = profile;
            await SaveDepProfileAsync(profile);
            Toasts.Success($"Re-detected: {string.Join(", ", profile.Runtimes.Select(r => $"{r.Runtime}:{r.Version}"))}");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task CheckChangesAsync()
    {
        if (_workspace is null) return;
        _checkingChanges = true;
        _changeSummary = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var totalFiles = 0; var totalAdds = 0; var totalDels = 0;
            var hasUncommitted = false;

            foreach (var link in _workspace.Links)
            {
                var repo = await Registry.GetAsync(link.RepositoryName);
                var repoPath = Path.Combine(_options.ReposRoot, link.RepositoryName);
                if (!Directory.Exists(repoPath)) continue;

                // Check uncommitted changes (modified/staged files not yet committed)
                if (await Git.HasUncommittedChangesAsync(repoPath))
                {
                    hasUncommitted = true;
                }

                // Check committed diff between default branch and feature branch
                var diff = await Git.GetDiffAsync(repoPath, repo?.DefaultBranch ?? "main", link.BranchName);
                if (!string.IsNullOrWhiteSpace(diff))
                {
                    var lines = diff.Split('\n');
                    totalFiles += lines.Count(l => l.StartsWith("+++ b/"));
                    totalAdds += lines.Count(l => l.StartsWith('+') && !l.StartsWith("+++"));
                    totalDels += lines.Count(l => l.StartsWith('-') && !l.StartsWith("---"));
                }
            }

            var hasChanges = totalFiles > 0 || hasUncommitted;
            _changeSummary = new(hasChanges, totalFiles, totalAdds, totalDels, hasUncommitted);
        }
        catch
        {
            _changeSummary = new(false, 0, 0, 0, false);
        }
        finally
        {
            _checkingChanges = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarkImplementDone()
    {
        _workflow.Steps[PipelineStep.Implement] = StepStatus.Passed;
        _activeStep = PipelineStep.Validate;
        await SaveWorkflowStateAsync();
    }

    // ── Validate Step — test config CRUD + runners ──────────────────────

    private async Task LoadTestConfigsAsync()
    {
        if (_workspace is null) return;
        var repoNames = _workspace.Links.Select(l => l.RepositoryName).ToList();
        _testConfigs = await Db.RepoTestConfigs
            .Where(c => repoNames.Contains(c.RepositoryName))
            .OrderBy(c => c.RepositoryName).ThenBy(c => c.Order)
            .ToListAsync();

        // Auto-seed from TechStackDetector if no configs exist for a repo
        foreach (var repoName in repoNames)
        {
            if (_testConfigs.Any(c => c.RepositoryName == repoName)) continue;
            var repoPath = Path.Combine(_options.ReposRoot, repoName);
            if (!Directory.Exists(repoPath)) continue;

            var stack = LightsOff.Infrastructure.Agents.TechStackDetector.Detect(repoPath);
            if (stack.TestCommand is null) continue;

            var seed = new RepoTestConfig
            {
                RepositoryName = repoName,
                Name = $"{stack.TestFramework ?? "Tests"}",
                Command = stack.TestCommand,
                Order = 1
            };
            Db.RepoTestConfigs.Add(seed);
            await Db.SaveChangesAsync();
            _testConfigs.Add(seed);
        }
    }

    private static readonly JsonSerializerOptions _jsonOpts = new(JsonSerializerDefaults.Web) { WriteIndented = false };

    private void LoadWorkflowState()
    {
        if (_workspace?.WorkflowStateJson is not null)
        {
            try
            {
                var loaded = JsonSerializer.Deserialize<WorkflowStatePersist>(_workspace.WorkflowStateJson, _jsonOpts);
                if (loaded is not null)
                {
                    if (loaded.Steps is not null)
                    {
                        foreach (var (step, status) in loaded.Steps)
                            _workflow.Steps[step] = status;
                    }
                    _analysis = loaded.Analysis;
                    _workflow.Analysis = _analysis;
                    _plan = loaded.Plan;
                    _workflow.Plan = _plan;
                    _activeStep = loaded.ActiveStep;
                }
            }
            catch { /* corrupt JSON — start fresh */ }
        }
    }

    private async Task SaveWorkflowStateAsync()
    {
        if (_workspace is null) return;
        try
        {
            var persist = new WorkflowStatePersist
            {
                Steps = _workflow.Steps,
                Analysis = _analysis,
                Plan = _plan,
                ActiveStep = _activeStep
            };
            var json = JsonSerializer.Serialize(persist, _jsonOpts);

            // Update directly via DB to avoid EF tracking issues
            await Db.Database.ExecuteSqlRawAsync(
                """UPDATE "Workspaces" SET "WorkflowStateJson" = {0} WHERE "TicketKey" = {1}""",
                json, _workspace.TicketKey);
        }
        catch { /* best-effort persistence */ }
    }

    private class WorkflowStatePersist
    {
        public Dictionary<PipelineStep, StepStatus>? Steps { get; set; }
        public TicketAnalysis? Analysis { get; set; }
        public ImplementationPlan? Plan { get; set; }
        public PipelineStep ActiveStep { get; set; }
    }

    private static List<string> GetCommands(RepoTestConfig config) =>
        (config.Command ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private static void SetCommands(RepoTestConfig config, List<string> commands) =>
        config.Command = string.Join('\n', commands);

    private void AddCommand(RepoTestConfig config)
    {
        var cmds = GetCommands(config);
        cmds.Add("");
        SetCommands(config, cmds);
    }

    private void UpdateCommand(RepoTestConfig config, int index, string value)
    {
        var cmds = GetCommands(config);
        if (index >= 0 && index < cmds.Count) cmds[index] = value;
        SetCommands(config, cmds);
    }

    private void RemoveCommand(RepoTestConfig config, int index)
    {
        var cmds = GetCommands(config);
        if (index >= 0 && index < cmds.Count) cmds.RemoveAt(index);
        SetCommands(config, cmds);
    }

    private void ToggleEditTest(int configId)
    {
        _editingTestId = _editingTestId == configId ? null : configId;
    }

    private void AddTestConfig(string repoName)
    {
        var nextOrder = _testConfigs.Where(c => c.RepositoryName == repoName).Select(c => c.Order).DefaultIfEmpty(0).Max() + 1;
        var config = new RepoTestConfig
        {
            RepositoryName = repoName,
            Name = "New test",
            Command = "",
            Order = nextOrder
        };
        Db.RepoTestConfigs.Add(config);
        Db.SaveChanges();
        _testConfigs.Add(config);
        _editingTestId = config.Id; // auto-open edit form for new entries
    }

    private async void SaveTestConfigAsync(RepoTestConfig config)
    {
        try
        {
            Db.RepoTestConfigs.Update(config);
            await Db.SaveChangesAsync();
        }
        catch { /* field-level save, tolerate concurrent edits */ }
    }

    private async void RemoveTestConfig(RepoTestConfig config)
    {
        _testConfigs.Remove(config);
        Db.RepoTestConfigs.Remove(config);
        await Db.SaveChangesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunSingleTestAsync(RepoTestConfig config)
    {
        if (_workspace?.ContainerId is null) { Toasts.Warning("No container running."); return; }
        var commands = GetCommands(config);
        if (commands.Count == 0) { Toasts.Warning("Add at least one command."); return; }
        _runningTests = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var workDir = string.IsNullOrWhiteSpace(config.WorkingDir)
                ? $"/workspace/{config.RepositoryName}"
                : $"/workspace/{config.RepositoryName}/{config.WorkingDir.Trim('/')}";

            var output = new System.Text.StringBuilder();
            var lastExitCode = 0;
            var allPassed = true;

            foreach (var cmd in commands)
            {
                if (string.IsNullOrWhiteSpace(cmd)) continue;
                output.AppendLine($"$ {cmd}");
                var exitCode = await Docker.ExecAsync(_workspace.ContainerId,
                    new[] { "sh", "-c", $"cd {workDir} && {cmd}" }, default);
                lastExitCode = exitCode;
                if (exitCode != 0)
                {
                    output.AppendLine($"✗ exit {exitCode}");
                    allPassed = false;
                    break; // stop on first failure
                }
                output.AppendLine("✓ ok");
            }

            _suiteResult ??= new TestSuiteResult();
            _suiteResult.Results.RemoveAll(r => r.ConfigName == config.Name && r.RepositoryName == config.RepositoryName);
            _suiteResult.Results.Add(new SingleTestResult(config.Name, string.Join(" && ", commands), config.WorkingDir,
                config.RepositoryName, lastExitCode, allPassed, output.ToString()));
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _runningTests = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task RunAllTestsAsync()
    {
        if (_workspace?.ContainerId is null) { Toasts.Warning("No container running."); return; }
        _runningTests = true;
        _suiteResult = new TestSuiteResult();
        _workflow.Steps[PipelineStep.Validate] = StepStatus.Running;
        await InvokeAsync(StateHasChanged);
        try
        {
            foreach (var config in _testConfigs)
            {
                var commands = GetCommands(config);
                if (commands.Count == 0) continue;
                var workDir = string.IsNullOrWhiteSpace(config.WorkingDir)
                    ? $"/workspace/{config.RepositoryName}"
                    : $"/workspace/{config.RepositoryName}/{config.WorkingDir.Trim('/')}";

                var output = new System.Text.StringBuilder();
                var lastExitCode = 0;
                var allPassed = true;

                foreach (var cmd in commands)
                {
                    if (string.IsNullOrWhiteSpace(cmd)) continue;
                    output.AppendLine($"$ {cmd}");
                    var exitCode = await Docker.ExecAsync(_workspace.ContainerId,
                        new[] { "sh", "-c", $"cd {workDir} && {cmd}" }, default);
                    lastExitCode = exitCode;
                    if (exitCode != 0) { output.AppendLine($"✗ exit {exitCode}"); allPassed = false; break; }
                    output.AppendLine("✓ ok");
                }

                _suiteResult.Results.Add(new SingleTestResult(config.Name, string.Join(" && ", commands), config.WorkingDir,
                    config.RepositoryName, lastExitCode, allPassed, output.ToString()));
                await InvokeAsync(StateHasChanged);
            }
            _workflow.Steps[PipelineStep.Validate] = _suiteResult.AllPassed ? StepStatus.Passed : StepStatus.Failed;
            Toasts.Success($"Tests: {_suiteResult.PassedCount} passed, {_suiteResult.FailedCount} failed.");
        }
        catch (Exception ex)
        {
            _workflow.Steps[PipelineStep.Validate] = StepStatus.Failed;
            Toasts.Error(ex.Message);
        }
        finally { _runningTests = false; await InvokeAsync(StateHasChanged); }
    }

