@page "/tickets/{TicketKey}"
@using LightsOff.Core.Configuration
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using LightsOff.Core.Utilities
@using Microsoft.Extensions.Options
@inject IJiraClient Jira
@inject IJiraConnectionProvider JiraProvider
@inject IGitHubClient GitHub
@inject IRepositoryRegistry Registry
@inject IWorkspaceManager Workspaces
@inject ICodeAgentProvider AgentProvider
@inject IDockerService Docker
@inject IGitService Git
@inject LightsOff.Infrastructure.Data.AppDbContext Db
@inject IOptions<LightsOffOptions> OptionsAccessor
@inject ToastService Toasts
@inject NavigationManager Nav
@inject TestRunnerService TestRunner
@inject StepRunnerService StepRunner
@inject MarkdownRenderer Markdown
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@TicketKey</PageTitle>

<nav class="flex items-center gap-2 text-sm text-zinc-500 mb-4">
    <a href="/tickets" class="hover:text-zinc-200 inline-flex items-center gap-1.5">
        <Icon Name="arrow-left" Class="w-4 h-4" /> Tickets
    </a>
    <span class="text-zinc-700">/</span>
    <span class="text-zinc-300"><code>@TicketKey</code></span>
</nav>

@if (_loadState == LoadState.NotConfigured)
{
    <Alert Kind="Alert.AlertKind.Warning">Jira is not configured. <a href="/settings" class="text-amber-100 underline underline-offset-2">Open settings</a>.</Alert>
}
else if (_loadState == LoadState.NotFound)
{
    <Alert Kind="Alert.AlertKind.Warning">Ticket <code>@TicketKey</code> not found.</Alert>
}
else if (_loadState == LoadState.Error)
{
    <Alert Kind="Alert.AlertKind.Error">@_loadError</Alert>
}
else if (_ticket is null)
{
    <div class="flex items-center gap-3 text-sm text-zinc-500 py-12 justify-center"><Spinner /> Loading…</div>
}
else
{
    <!-- Ticket header -->
    <div class="mb-6">
        <div class="flex items-start gap-3 mb-2">
            <code class="text-xl font-semibold text-emerald-400">@_ticket.Key</code>
            <span class="@StatusBadge(_ticket.Status) mt-1.5">@_ticket.Status</span>
        </div>
        <h1 class="text-2xl font-semibold tracking-tight">@_ticket.Summary</h1>
        @if (!string.IsNullOrEmpty(_ticket.Description))
        {
            <details class="mt-3 group/desc">
                <summary class="text-xs text-zinc-500 cursor-pointer hover:text-zinc-300 inline-flex items-center gap-1.5 mb-1">
                    <Icon Name="chevron-right" Class="w-3 h-3 transition-transform group-open/desc:rotate-90" />
                    Description
                </summary>
                <div class="text-sm text-zinc-300 leading-relaxed border-l-2 border-zinc-800 pl-4 ml-1 space-y-2
                            [&_h1]:text-base [&_h1]:font-semibold [&_h1]:text-zinc-100 [&_h1]:mt-3
                            [&_h2]:text-sm [&_h2]:font-semibold [&_h2]:text-zinc-200 [&_h2]:mt-3
                            [&_h3]:text-xs [&_h3]:font-semibold [&_h3]:text-zinc-200 [&_h3]:uppercase [&_h3]:tracking-wider [&_h3]:mt-3
                            [&_p]:text-zinc-400
                            [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:text-zinc-400
                            [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:text-zinc-400
                            [&_li]:py-0.5
                            [&_code]:text-emerald-400 [&_code]:text-xs [&_code]:font-mono [&_code]:bg-zinc-900 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded
                            [&_a]:text-emerald-400 [&_a]:underline [&_a]:underline-offset-2
                            [&_strong]:text-zinc-200 [&_strong]:font-semibold">
                    @((MarkupString)(_ticket.Description ?? ""))
                </div>
            </details>
        }
    </div>

    @if (_workspace is not null)
    {
        var qualityGaps = _ticket is not null
            ? LightsOff.Infrastructure.Pipeline.TicketQualityChecker.Check(_ticket)
            : (IReadOnlyList<Gap>)Array.Empty<Gap>();
        var hasBlockingQuality = LightsOff.Infrastructure.Pipeline.TicketQualityChecker.HasBlockingConcerns(qualityGaps);
        var defaultAgentForChain = AgentProvider.GetDefaultAgent();
        var sessionCapableForChain = defaultAgentForChain.Id == LightsOff.Infrastructure.Agents.ClaudeCliAgent.AgentId
                                  || defaultAgentForChain.Id == LightsOff.Infrastructure.Agents.CopilotCliAgent.AgentId
                                  || defaultAgentForChain.Id == LightsOff.Infrastructure.Demo.DemoCodeAgent.AgentIdConst;
        var chainIsActive = StepRunner.IsRunning(TicketKey);
        var canStartChain = sessionCapableForChain && (_plan?.IsApproved == true) && !chainIsActive;

        <!-- Pre-flight: ticket-quality warning banner. Warn-only; never blocks. -->
        @if (hasBlockingQuality && !_dismissedQualityWarning)
        {
            <div class="mb-4 rounded-lg border border-amber-500/30 bg-amber-500/5 px-4 py-3">
                <div class="flex items-start gap-3">
                    <Icon Name="alert" Class="w-4 h-4 text-amber-400 mt-0.5 flex-shrink-0" />
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-semibold text-amber-200">Ticket quality may be low</div>
                        <ul class="mt-1.5 space-y-0.5 text-xs text-amber-300/80">
                            @foreach (var g in qualityGaps.Where(g => g.Severity == GapSeverity.Error))
                            {
                                <li>• @g.Detail</li>
                            }
                        </ul>
                        <div class="mt-2 flex gap-2">
                            <button type="button" @onclick="() => _dismissedQualityWarning = true"
                                    class="text-[11px] px-2.5 py-1 rounded border border-amber-700/50 text-amber-200 hover:bg-amber-950/40">
                                Proceed anyway
                            </button>
                            <button type="button" @onclick="LoadTicketAsync"
                                    class="text-[11px] px-2.5 py-1 rounded border border-zinc-800 text-zinc-300 hover:bg-zinc-800/40">
                                Refresh from Jira
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Autonomous chain CTA. Visible when plan is approved + agent is session-capable. -->
        @if (sessionCapableForChain && _plan?.IsApproved == true)
        {
            <div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-3 flex items-center justify-between gap-4">
                <div class="text-sm">
                    <div class="font-semibold text-emerald-200">Autonomous run</div>
                    <div class="text-xs text-emerald-300/70">Implement → Validate → Commit → Submit, hands-off. Cancel any time.</div>
                </div>
                @if (chainIsActive)
                {
                    <button type="button" @onclick="CancelImplementRunAsync"
                            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs text-red-300 hover:text-red-200 border border-red-900/60 hover:bg-red-950/40 transition-colors">
                        <Icon Name="x" Class="w-3 h-3" /> Cancel chain
                    </button>
                }
                else
                {
                    <button type="button" @onclick="StartAutonomousChainAsync" disabled="@(!canStartChain)"
                            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                        <Icon Name="play" Class="w-3 h-3" /> Start autonomous run
                    </button>
                }
            </div>
        }

        <!-- Pipeline view -->
        <PipelineStepper State="_workflow" ActiveStep="_activeStep" OnStepClick="SetActiveStep" />

        <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-6">
            @switch (_activeStep)
            {
                // Analyze + Plan are merged into a single "Understand & Plan" view.
                case PipelineStep.Analyze:
                case PipelineStep.Plan:
                    @RenderPlanStep()
                    break;
                case PipelineStep.Implement:
                    @RenderImplementStep()
                    break;
                // Review is folded into Validate.
                case PipelineStep.Validate:
                case PipelineStep.Review:
                    @RenderValidateStep()
                    break;
                case PipelineStep.Submit:
                    @RenderSubmitStep()
                    break;
            }
        </div>
    }
    else
    {
        <!-- Workspace creation (same as before but condensed) -->
        @RenderWorkspaceCreation()
    }
}

@code {
    private enum LoadState { Loading, Loaded, NotConfigured, NotFound, Error }

    [Parameter] public string TicketKey { get; set; } = string.Empty;

    private LightsOffOptions _options = new();
    private Ticket? _ticket;
    private Workspace? _workspace;
    private WorkflowState _workflow = new();
    private PipelineStep _activeStep = PipelineStep.Plan;
    private LoadState _loadState = LoadState.Loading;
    private string? _loadError;
    private bool? _dockerAvailable;

    // Analysis state
    private TicketAnalysis? _analysis;
    private bool _analyzing;
    private string _streamingText = string.Empty;

    // Plan state
    private ImplementationPlan? _plan;
    private string _planComment = string.Empty;
    private bool _planPanelOpen;

    // Validate state
    private List<RepoTestConfig> _testConfigs = new();
    private TestSuiteResult? _suiteResult;
    private bool _runningTests;
    private int? _editingTestId;

    // Review state
    private CodeReview? _review;
    private bool _reviewing;

    // Implement state — dependencies
    private Dictionary<string, RepoDependencyProfile> _depProfiles = new();
    private string? _depEditing;
    private bool _reinstalling;

    // Implement state — changes
    private ChangeSummary? _changeSummary;
    private bool _checkingChanges;

    // Submit state
    private IReadOnlyList<PullRequestResult>? _submitResults;
    private bool _submitting;

    private record ChangeSummary(bool HasChanges, int FilesChanged, int Additions, int Deletions, bool HasUncommitted);

    // Create workspace state
    private IReadOnlyList<GitHubRepo>? _githubRepos;
    private bool _loadingRepos;
    private string? _reposError;
    private string _query = string.Empty;
    private readonly HashSet<string> _selectedRepos = new(StringComparer.OrdinalIgnoreCase);
    private string _branchName = string.Empty;
    private bool _creating;
    private string? _createError;

    protected override async Task OnParametersSetAsync()
    {
        _options = OptionsAccessor.Value;
        _branchName = TextSlug.BuildBranchName(_options.BranchNameTemplate, TicketKey, string.Empty);

        try
        {
            var connection = await JiraProvider.GetAsync();
            if (connection is null) { _loadState = LoadState.NotConfigured; return; }

            _ticket = await Jira.GetIssueAsync(TicketKey);
            _workspace = await Workspaces.GetAsync(TicketKey);
            _dockerAvailable = await Docker.IsDockerAvailableAsync();

            if (_ticket is null) { _loadState = LoadState.NotFound; return; }

            _branchName = TextSlug.BuildBranchName(_options.BranchNameTemplate, _ticket.Key, _ticket.Summary);
            _loadState = LoadState.Loaded;

            if (_workspace is not null)
            {
                LoadWorkflowState();
                await RestoreQuestionsStateAsync();
                await LoadTestConfigsAsync();
                await LoadDepProfilesAsync();

                // Subscribe to test runner for live updates (survives F5)
                TestRunner.RunUpdated -= OnTestRunUpdated; // prevent double-subscribe
                TestRunner.RunUpdated += OnTestRunUpdated;
                StepRunner.RunUpdated -= OnStepRunUpdated;
                StepRunner.RunUpdated += OnStepRunUpdated;
                var activeRun = TestRunner.GetActiveRun(TicketKey);
                if (activeRun is not null)
                {
                    _suiteResult = activeRun.Suite;
                    _runningTests = activeRun.IsRunning;
                }
                // Fire AI work in the background — page renders immediately.
                if (_workflow.Steps[PipelineStep.Analyze] == StepStatus.Pending)
                    _ = InvokeAsync(RunAnalysisAsync);
            }
            else
            {
                _ = LoadGitHubReposAsync();
            }
        }
        catch (Exception ex) { _loadState = LoadState.Error; _loadError = ex.Message; }
    }

    private void SetActiveStep(PipelineStep step)
    {
        if (_workflow.IsStepUnlocked(step))
            _activeStep = step;
    }

    // ── Analyze Step ────────────────────────────────────────────────────

    private bool _refiningAnalysis;

    private async Task OnAnalyzeChatSendAsync(string text)
    {
        if (_analysis is null || _ticket is null) return;
        if (_refiningAnalysis) return;

        _analysis.Conversation.Add(new ChatMessage(ChatMessage.RoleUser, text, DateTimeOffset.UtcNow));
        _refiningAnalysis = true;
        await SaveWorkflowStateAsync();
        await InvokeAsync(StateHasChanged);

        try
        {
            var agent = AgentProvider.GetDefaultAgent();
            var contexts = new List<RepoContext>();
            if (_workspace?.Links is not null)
            {
                foreach (var link in _workspace.Links)
                {
                    var repoPath = Path.Combine(_options.ReposRoot, link.RepositoryName);
                    if (Directory.Exists(repoPath))
                    {
                        try { contexts.Add(await agent.AnalyzeRepositoryAsync(repoPath, ct: default)); }
                        catch { }
                    }
                }
            }

            var refined = await agent.RefineAnalysisAsync(_ticket, _analysis, _analysis.Conversation, contexts);
            // Carry conversation forward + append agent's brief reply summarizing what changed.
            refined.Conversation = _analysis.Conversation.ToList();
            refined.Conversation.Add(new ChatMessage(
                ChatMessage.RoleAgent,
                BuildAnalysisDeltaSummary(_analysis, refined),
                DateTimeOffset.UtcNow));
            _analysis = refined;
            _workflow.Analysis = _analysis;
            _workflow.Steps[PipelineStep.Analyze] = _analysis.HasErrors ? StepStatus.Warning : StepStatus.Passed;
            await SaveWorkflowStateAsync();
        }
        catch (NotSupportedException)
        {
            _analysis.Conversation.Add(new ChatMessage(
                ChatMessage.RoleSystem,
                "This agent doesn't support analysis refinement. Switch to claude-cli in Settings.",
                DateTimeOffset.UtcNow));
            await SaveWorkflowStateAsync();
        }
        catch (Exception ex)
        {
            _analysis.Conversation.Add(new ChatMessage(
                ChatMessage.RoleSystem,
                $"Refinement failed: {ex.Message}",
                DateTimeOffset.UtcNow));
            Toasts.Error($"Refinement failed: {ex.Message}");
            await SaveWorkflowStateAsync();
        }
        finally
        {
            _refiningAnalysis = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildAnalysisDeltaSummary(TicketAnalysis before, TicketAnalysis after)
    {
        var parts = new List<string>();
        var resolved = before.Gaps.Count - after.Gaps.Count;
        if (resolved > 0) parts.Add($"resolved {resolved} gap(s)");
        if (after.Tasks.Count != before.Tasks.Count)
            parts.Add($"tasks: {before.Tasks.Count} → {after.Tasks.Count}");
        if (after.RelevantFiles.Count != before.RelevantFiles.Count)
            parts.Add($"relevant files: {before.RelevantFiles.Count} → {after.RelevantFiles.Count}");
        return parts.Count == 0
            ? "Analysis updated."
            : "Analysis updated — " + string.Join(", ", parts) + ".";
    }

    private async Task RunAnalysisAsync()
    {
        _analyzing = true;
        _analysis = null;
        _plan = null;
        _streamingText = string.Empty;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var agent = AgentProvider.GetDefaultAgent();
            var contexts = await GetRepoContextsAsync(agent);

            var analysisProgress = new Progress<string>(chunk =>
            {
                _streamingText += chunk;
                InvokeAsync(StateHasChanged);
            });
            _analysis = await agent.AnalyzeTicketAsync(_ticket!, contexts, analysisProgress);
            _workflow.Analysis = _analysis;
            _workflow.Steps[PipelineStep.Analyze] = _analysis.HasErrors ? StepStatus.Warning : StepStatus.Passed;
            await SaveWorkflowStateAsync();
            await InvokeAsync(StateHasChanged);

            // Decision point: do we have blocking analysis questions? If yes, post them as an
            // inline question card in the chat thread. The plan only generates after the user
            // answers (or skips) them — answered Q+A pairs become user chat messages that the
            // refine-analysis prompt sees as conversation history.
            var analysisQuestions = ExtractAnalysisQuestions(_analysis);
            if (analysisQuestions.Count > 0)
            {
                PostQuestionsToChat(QuestionPhase.Analysis, analysisQuestions);
                await SaveWorkflowStateAsync();
                return;
            }

            // No analysis blockers → generate the plan straight away.
            await GeneratePlanFromAnalysisAsync(agent, contexts);
        }
        catch (Exception ex)
        {
            _workflow.Steps[PipelineStep.Analyze] = StepStatus.Failed;
            Toasts.Error($"Analysis failed: {ex.Message}");
        }
        finally
        {
            _analyzing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<List<RepoContext>> GetRepoContextsAsync(ICodeAgent agent)
    {
        var contexts = new List<RepoContext>();
        if (_workspace?.Links is not null)
        {
            foreach (var link in _workspace.Links)
            {
                var repoPath = Path.Combine(_options.ReposRoot, link.RepositoryName);
                if (Directory.Exists(repoPath))
                {
                    try { contexts.Add(await agent.AnalyzeRepositoryAsync(repoPath, ct: default)); }
                    catch { }
                }
            }
        }
        return contexts;
    }

    /// <summary>
    /// Pull blocking concerns from the analysis — Error gaps phrased as questions. Surfaced as
    /// inline question cards in the chat thread before plan generation runs.
    /// </summary>
    private static IReadOnlyList<OpenQuestion> ExtractAnalysisQuestions(TicketAnalysis analysis)
    {
        // Prefer agent-generated questions (with suggestions) over raw gap conversion.
        if (analysis.OpenQuestions.Count > 0)
            return analysis.OpenQuestions;

        // Fallback for older persisted analyses that pre-date openQuestions.
        return analysis.Gaps
            .Where(g => g.Severity == GapSeverity.Error)
            .Select(g => new OpenQuestion(g.Detail, Array.Empty<string>()))
            .ToList();
    }

    private async Task GeneratePlanFromAnalysisAsync(ICodeAgent agent, List<RepoContext> contexts)
    {
        if (_analysis is null || _ticket is null) return;

        _generatingPlan = true;
        _streamingText = string.Empty;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Approved/ChangesRequested plans are preserved across re-runs; only fresh-draft slots
            // get overwritten.
            if (_plan is null || _plan.Status is PlanStatus.Rejected or PlanStatus.Draft)
            {
                var planProgress = new Progress<string>(chunk =>
                {
                    _streamingText += chunk;
                    InvokeAsync(StateHasChanged);
                });
                _plan = await agent.GeneratePlanAsync(_ticket, _analysis, contexts, planProgress);
                _workflow.Plan = _plan;
                _workflow.Steps[PipelineStep.Plan] = StepStatus.AwaitingApproval;
                PostPlanCardToChat();
                await SaveWorkflowStateAsync();
            }

            // Plan may carry its own OpenQuestions — surface them as a question card in the chat.
            if (_plan is not null && _plan.OpenQuestions.Count > 0)
            {
                PostQuestionsToChat(QuestionPhase.Plan, _plan.OpenQuestions);
            }
        }
        catch (Exception ex)
        {
            _workflow.Steps[PipelineStep.Plan] = StepStatus.Failed;
            Toasts.Error($"Plan generation failed: {ex.Message}");
            _analysis?.Conversation.Add(new ChatMessage(
                ChatMessage.RoleSystem,
                $"Plan generation failed: {ex.Message}",
                DateTimeOffset.UtcNow));
            // Persist so the error survives reloads (and so we don't auto-retry forever).
            try { await SaveWorkflowStateAsync(); } catch { }
        }
        finally
        {
            _generatingPlan = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RetryGeneratePlanAsync()
    {
        try
        {
            var agent = AgentProvider.GetDefaultAgent();
            var contexts = await GetRepoContextsAsync(agent);
            await GeneratePlanFromAnalysisAsync(agent, contexts);
        }
        catch (Exception ex)
        {
            // Fire-and-forget tasks must catch their own exceptions — otherwise they vanish.
            _analysis?.Conversation.Add(new ChatMessage(
                ChatMessage.RoleSystem,
                $"Plan generation failed: {ex.Message}",
                DateTimeOffset.UtcNow));
            await SaveWorkflowStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Inline question card state + handlers ───────────────────────────

    private bool _generatingPlan;
    private string? _activeQuestionsBatchId;
    private QuestionPhase _activeQuestionsPhase;

    private enum QuestionPhase { Analysis, Plan }

    /// <summary>
    /// Append an agent chat message carrying a question batch as an inline attachment. The user
    /// answers via the <c>ChatQuestionCard</c> rendered inside that message.
    /// </summary>
    private void PostQuestionsToChat(QuestionPhase phase, IReadOnlyList<OpenQuestion> questions)
    {
        if (_analysis is null || questions.Count == 0) return;

        var batchId = Guid.NewGuid().ToString("N");
        var payload = new QuestionsPayload
        {
            BatchId = batchId,
            Questions = questions.ToList(),
            Answers = new(),
            Closed = false
        };
        var narrative = phase == QuestionPhase.Analysis
            ? $"I have {questions.Count} question{(questions.Count == 1 ? "" : "s")} before drafting the plan."
            : $"The plan has {questions.Count} open question{(questions.Count == 1 ? "" : "s")}. Answer them inline so I can refine.";

        _analysis.Conversation.Add(new ChatMessage(
            ChatMessage.RoleAgent,
            narrative,
            DateTimeOffset.UtcNow,
            new ChatAttachment(
                ChatAttachment.KindQuestions,
                $"{questions.Count} question{(questions.Count == 1 ? "" : "s")}",
                null,
                JsonSerializer.Serialize(payload, _jsonOpts))));

        _activeQuestionsBatchId = batchId;
        _activeQuestionsPhase = phase;
    }

    /// <summary>
    /// User submitted an answer to a specific question in a batch. Mutate the batch's payload,
    /// re-serialize the attachment, append a user chat message echoing the Q+A, and finalize
    /// the batch when all questions are answered or skipped.
    /// </summary>
    private async Task OnQuestionSubmit((string BatchId, int Index, string Answer) args)
    {
        var batch = FindActiveBatchPayload(args.BatchId);
        if (batch is null || _analysis is null) return;

        batch.Answers[args.Index] = args.Answer;
        UpdateBatchAttachmentJson(args.BatchId, batch);
        await SaveWorkflowStateAsync();
        await InvokeAsync(StateHasChanged);

        await TryFinalizeBatchAsync(batch);
    }

    private async Task OnQuestionSkipped((string BatchId, int Index) args)
    {
        var batch = FindActiveBatchPayload(args.BatchId);
        if (batch is null || _analysis is null) return;

        batch.Answers[args.Index] = string.Empty;
        UpdateBatchAttachmentJson(args.BatchId, batch);
        await SaveWorkflowStateAsync();
        await InvokeAsync(StateHasChanged);

        await TryFinalizeBatchAsync(batch);
    }

    private async Task OnQuestionsDismissed(string batchId)
    {
        var batch = FindActiveBatchPayload(batchId);
        if (batch is null) return;

        // Mark unanswered questions as skipped (empty), then finalize.
        for (var i = 0; i < batch.Questions.Count; i++)
            if (!batch.Answers.ContainsKey(i)) batch.Answers[i] = string.Empty;
        UpdateBatchAttachmentJson(batchId, batch);

        await TryFinalizeBatchAsync(batch);
    }

    /// <summary>
    /// When all questions in a batch are answered (including skipped), close the batch and fire
    /// the appropriate next-phase handler — refine analysis + generate plan, or rework plan.
    /// </summary>
    private async Task TryFinalizeBatchAsync(QuestionsPayload batch)
    {
        if (batch.Answers.Count < batch.Questions.Count) return;  // still pending

        batch.Closed = true;
        UpdateBatchAttachmentJson(batch.BatchId, batch);
        _activeQuestionsBatchId = null;

        // Post all Q&A pairs as a single user message now that the batch is complete.
        if (_analysis is not null)
        {
            var lines = new System.Text.StringBuilder();
            for (var i = 0; i < batch.Questions.Count; i++)
            {
                var qText = batch.Questions[i].Text;
                var aText = batch.Answers.TryGetValue(i, out var a) ? a : string.Empty;
                lines.AppendLine($"**{qText}**");
                lines.AppendLine(string.IsNullOrEmpty(aText) ? "_(skipped — let the agent decide)_" : aText);
                if (i < batch.Questions.Count - 1) lines.AppendLine();
            }
            _analysis.Conversation.Add(new ChatMessage(ChatMessage.RoleUser, lines.ToString().TrimEnd(), DateTimeOffset.UtcNow));
        }

        // Show pending state IMMEDIATELY — the slow work (save, repo contexts, refine, plan) is
        // about to start and the user must see the agent is "thinking" right after their answer.
        var phase = _activeQuestionsPhase;
        if (phase == QuestionPhase.Analysis) _refiningAnalysis = true;
        else if (phase == QuestionPhase.Plan) _replanning = true;
        await InvokeAsync(StateHasChanged);

        await SaveWorkflowStateAsync();

        var agent = AgentProvider.GetDefaultAgent();
        var contexts = await GetRepoContextsAsync(agent);

        if (phase == QuestionPhase.Analysis && _analysis is not null)
        {
            var nonSkipped = batch.Answers.Values.Count(a => !string.IsNullOrWhiteSpace(a));
            try
            {
                if (nonSkipped > 0)
                {
                    var refined = await agent.RefineAnalysisAsync(_ticket!, _analysis, _analysis.Conversation, contexts);
                    refined.Conversation = _analysis.Conversation.ToList();
                    refined.Conversation.Add(new ChatMessage(
                        ChatMessage.RoleAgent,
                        BuildAnalysisDeltaSummary(_analysis, refined),
                        DateTimeOffset.UtcNow));
                    _analysis = refined;
                    _workflow.Analysis = _analysis;
                    _workflow.Steps[PipelineStep.Analyze] = _analysis.HasErrors ? StepStatus.Warning : StepStatus.Passed;
                    await SaveWorkflowStateAsync();
                }
            }
            catch (NotSupportedException) { /* fall through */ }
            catch (Exception ex) { Toasts.Error($"Refine analysis failed: {ex.Message}"); }
            finally { _refiningAnalysis = false; }

            await GeneratePlanFromAnalysisAsync(agent, contexts);
        }
        else if (phase == QuestionPhase.Plan && _plan is not null)
        {
            var feedback = FormatAnswersForAgent(batch);
            await ReworkPlanWithFeedbackAsync(feedback);
            if (_plan is not null && _plan.OpenQuestions.Count > 0)
            {
                PostQuestionsToChat(QuestionPhase.Plan, _plan.OpenQuestions);
                await SaveWorkflowStateAsync();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private QuestionsPayload? FindActiveBatchPayload(string batchId)
    {
        if (_analysis is null) return null;
        for (var i = _analysis.Conversation.Count - 1; i >= 0; i--)
        {
            var att = _analysis.Conversation[i].Attachment;
            if (att is { Kind: ChatAttachment.KindQuestions, PayloadJson: { } json })
            {
                try
                {
                    var payload = JsonSerializer.Deserialize<QuestionsPayload>(json, _jsonOpts);
                    if (payload?.BatchId == batchId) return payload;
                }
                catch { }
            }
        }
        return null;
    }

    /// <summary>
    /// Replace the chat-message attachment JSON for a given batch with a fresh serialization of
    /// the supplied payload. The chat thread re-renders against the new JSON.
    /// </summary>
    private void UpdateBatchAttachmentJson(string batchId, QuestionsPayload payload)
    {
        if (_analysis is null) return;
        for (var i = _analysis.Conversation.Count - 1; i >= 0; i--)
        {
            var msg = _analysis.Conversation[i];
            var att = msg.Attachment;
            if (att is { Kind: ChatAttachment.KindQuestions, PayloadJson: { } json })
            {
                try
                {
                    var existing = JsonSerializer.Deserialize<QuestionsPayload>(json, _jsonOpts);
                    if (existing?.BatchId == batchId)
                    {
                        var updated = att with { PayloadJson = JsonSerializer.Serialize(payload, _jsonOpts) };
                        _analysis.Conversation[i] = msg with { Attachment = updated };
                        return;
                    }
                }
                catch { }
            }
        }
    }

    private static string FormatAnswersForAgent(QuestionsPayload batch)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Answers to your open questions:");
        sb.AppendLine();
        for (var i = 0; i < batch.Questions.Count; i++)
        {
            var q = batch.Questions[i].Text;
            var a = batch.Answers.GetValueOrDefault(i, string.Empty);
            sb.AppendLine($"**Q: {q}**");
            sb.AppendLine();
            sb.AppendLine(string.IsNullOrWhiteSpace(a) ? "_(skipped — please assume a sensible default)_" : a);
            sb.AppendLine();
        }
        return sb.ToString().TrimEnd();
    }

    // Analyze is now folded into Plan — RenderAnalyzeStep is no longer reachable from the
    // stepper, but if any persisted workflow lands on it, we route to Plan via the switch.
    private RenderFragment RenderAnalyzeStep() => RenderPlanStep();

    // ── Plan Step (merged with Analyze) ─────────────────────────────────

    private RenderFragment RenderPlanStep() => __builder =>
    {
        var isBusy = _replanning || _refiningAnalysis || _analyzing || _generatingPlan;
        // Pending = an active inline question card in the chat thread is open and unanswered.
        var hasPendingQuestions = _activeQuestionsBatchId is not null;

        <!-- Single column, ChatGPT-style: centered, max-w-3xl, vertical sections. -->
        <div class="max-w-3xl mx-auto">
            @if (_plan is null && _analysis is null && !isBusy)
            {
                <!-- Empty state — no analysis or plan yet -->
                <div class="flex flex-col items-center justify-center py-20 text-center">
                    <div class="w-14 h-14 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mb-5">
                        <Icon Name="play" Class="w-6 h-6 text-emerald-300" />
                    </div>
                    <div class="text-base text-zinc-100 font-semibold mb-1">Ready to plan</div>
                    <div class="text-sm text-zinc-500 max-w-md mb-6 leading-relaxed">
                        Analyze the ticket against your repos. If anything is unclear, the agent will ask before generating a plan.
                    </div>
                    <button type="button" @onclick="RunAnalysisAsync"
                            class="inline-flex items-center gap-2 h-10 px-5 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-semibold text-sm transition-all shadow-sm hover:shadow-emerald-500/30">
                        <Icon Name="play" Class="w-4 h-4" /> Start
                    </button>
                </div>
            }
            else
            {
                var pendingHint = _analyzing ? "Analyzing ticket + repos…"
                    : _generatingPlan ? "Generating plan…"
                    : _refiningAnalysis ? "Refining analysis…"
                    : "Reworking plan…";

                var placeholder = _plan is null
                    ? "Add a clarification or just say 'retry' to draft the plan…"
                    : "Ask, clarify, push back, or request changes…";

                <!-- Conversation thread is the primary surface. The plan lives inside it as an
                     artifact card; clicking opens the side panel with the full markdown. -->
                <ChatThread Messages="@_unifiedChatMessages"
                            OnSend="OnPlanChatSendAsync"
                            IsPending="isBusy"
                            Title="Conversation"
                            Placeholder="@placeholder"
                            EmptyTitle="Thinking…"
                            EmptyHint=""
                            PendingHint="@pendingHint"
                            ActiveQuestionsBatchId="@_activeQuestionsBatchId"
                            OnQuestionSubmit="OnQuestionSubmit"
                            OnQuestionSkipped="OnQuestionSkipped"
                            OnQuestionsDismissed="OnQuestionsDismissed"
                            Plan="_plan"
                            OnOpenPlan="@(() => _planPanelOpen = true)" />

                @* No retry button — the chat handles everything. After a failed generation,
                   the user can type any message to retry (and add clarifications). *@
            }
        </div>

        <!-- Side panel: full plan rendered as markdown, with inline approve/reject. -->
        <PlanSidePanel IsOpen="_planPanelOpen"
                       Plan="_plan"
                       HasPendingQuestions="hasPendingQuestions"
                       Disabled="isBusy"
                       OnClose="@(() => _planPanelOpen = false)"
                       OnApprove="ApprovePlanFromPanelAsync"
                       OnReject="RejectPlanFromPanelAsync" />

    };

    /// <summary>
    /// Combined chat history: the plan's own comments PLUS the analysis conversation merged
    /// chronologically. The merged step has one conversation surface — both refinement paths
    /// (analyze and plan) feed into the same thread.
    /// </summary>
    private IReadOnlyList<ChatMessage> _unifiedChatMessages
    {
        get
        {
            var msgs = new List<ChatMessage>();
            if (_analysis is not null)
                msgs.AddRange(_analysis.Conversation);
            if (_plan is not null)
            {
                msgs.AddRange(_plan.Comments.Select(c => new ChatMessage(
                    c.Type switch
                    {
                        PlanCommentType.ChangeRequest => ChatMessage.RoleUser,
                        PlanCommentType.Question      => ChatMessage.RoleUser,
                        PlanCommentType.Note          => c.Author == "Agent" ? ChatMessage.RoleAgent : ChatMessage.RoleUser,
                        _                             => ChatMessage.RoleSystem
                    },
                    c.Content,
                    c.At)));
            }
            return msgs.OrderBy(m => m.At).ToList();
        }
    }

    /// <summary>
    /// User answered one of the open questions inline. Format the Q+A as a readable chat
    /// message and reuse the existing rework path.
    /// </summary>
    private async Task OnAnswerOpenQuestionAsync((string Question, string Answer) qa)
    {
        var formatted = $"**Q: {qa.Question}**\n\n{qa.Answer}";
        await ReworkPlanWithFeedbackAsync(formatted);
    }

    /// <summary>
    /// Adapt the plan's <c>Comments</c> list into the unified <c>ChatMessage</c> shape the
    /// thread component understands. Approval/rejection comments render as system messages so
    /// they're visually de-emphasized; change requests + answers render as user messages.
    /// </summary>
    private IReadOnlyList<ChatMessage> _planChatMessages =>
        _plan?.Comments.Select(c => new ChatMessage(
            c.Type switch
            {
                PlanCommentType.ChangeRequest => ChatMessage.RoleUser,
                PlanCommentType.Question      => ChatMessage.RoleUser,
                PlanCommentType.Note          => c.Author == "Agent" ? ChatMessage.RoleAgent : ChatMessage.RoleUser,
                _                             => ChatMessage.RoleSystem
            },
            c.Content,
            c.At)).ToList()
        ?? (IReadOnlyList<ChatMessage>)Array.Empty<ChatMessage>();

    private async Task ApprovePlan()
    {
        if (_plan is null) return;
        _plan.Status = PlanStatus.Approved;
        _plan.Comments.Add(new PlanComment(DateTimeOffset.UtcNow, "You", PlanCommentType.Approval, string.IsNullOrWhiteSpace(_planComment) ? "Approved." : _planComment));
        _workflow.Steps[PipelineStep.Plan] = StepStatus.Passed;
        _workflow.Steps[PipelineStep.Implement] = StepStatus.Running;
        _planComment = string.Empty;
        _activeStep = PipelineStep.Implement;
        Toasts.Success("Plan approved. Implement step unlocked.");
        await SaveWorkflowStateAsync();
    }

    private async Task ApprovePlanFromPanelAsync()
    {
        await ApprovePlan();
        _planPanelOpen = false;
    }

    private async Task RejectPlanFromPanelAsync()
    {
        await RejectPlan();
        _planPanelOpen = false;
    }

    /// <summary>
    /// Adds an agent chat message with a <see cref="ChatAttachment.KindPlan"/> attachment so the
    /// plan renders inline as an artifact card. Always posts — if the plan also has open questions
    /// they appear as a separate card below, and this card surfaces an "N open questions" badge so
    /// the state is unambiguous. Showing the new plan even when questions remain is critical —
    /// the user has to know the agent produced something.
    /// </summary>
    private void PostPlanCardToChat(bool isRework = false)
    {
        if (_analysis is null || _plan is null) return;

        var verb = isRework ? "reworked the plan" : "drafted an implementation plan";
        var openQ = _plan.OpenQuestions.Count;
        var trailer = openQ > 0
            ? $" {openQ} open question{(openQ == 1 ? "" : "s")} below — answer to refine."
            : " Click the card to review.";
        var narrative = $"I've {verb} — {_plan.Tasks.Count} task" +
            (_plan.Tasks.Count == 1 ? "" : "s") + ", " + _plan.PlannedChanges.Count +
            " file change" + (_plan.PlannedChanges.Count == 1 ? "" : "s") + "." + trailer;
        _analysis.Conversation.Add(new ChatMessage(
            ChatMessage.RoleAgent,
            narrative,
            DateTimeOffset.UtcNow,
            new ChatAttachment(ChatAttachment.KindPlan, "Implementation plan", null, null)));
    }

    private async Task OnPlanChatSendAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;

        // If we already have a plan, the message is rework feedback (existing path adds to plan
        // comments, which surface as user messages via _unifiedChatMessages).
        if (_plan is not null)
        {
            await ReworkPlanWithFeedbackAsync(text);
            return;
        }

        // No plan yet (analysis succeeded but plan generation failed or hasn't run). Treat the
        // message as both clarification + retry signal: append to the analysis conversation so
        // the agent sees it, then kick off plan generation.
        if (_analysis is null) return;

        _analysis.Conversation.Add(new ChatMessage(ChatMessage.RoleUser, text, DateTimeOffset.UtcNow));
        // Show pending state IMMEDIATELY — the next steps (save, repo contexts, plan gen) take
        // many seconds and the user must see "Generating plan…" the instant they hit Enter.
        _generatingPlan = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await SaveWorkflowStateAsync();
            var agent = AgentProvider.GetDefaultAgent();
            var contexts = await GetRepoContextsAsync(agent);
            await GeneratePlanFromAnalysisAsync(agent, contexts);
        }
        catch (Exception ex)
        {
            _analysis.Conversation.Add(new ChatMessage(
                ChatMessage.RoleSystem,
                $"Plan generation failed: {ex.Message}",
                DateTimeOffset.UtcNow));
            try { await SaveWorkflowStateAsync(); } catch { }
        }
        finally
        {
            _generatingPlan = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReworkPlanWithFeedbackAsync(string feedback)
    {
        if (_plan is null || string.IsNullOrWhiteSpace(feedback)) return;
        // No re-entrance guard: callers (TryFinalizeBatchAsync, OnPlanChatSendAsync) need to set
        // _replanning early for instant visual feedback before invoking us. Setting it here is
        // idempotent.

        _plan.Comments.Add(new PlanComment(DateTimeOffset.UtcNow, "You", PlanCommentType.ChangeRequest, feedback));
        _plan.Status = PlanStatus.ChangesRequested;
        _workflow.Steps[PipelineStep.Plan] = StepStatus.Running;
        _replanning = true;
        // Render BEFORE the DB save so the user sees their message + pending dots instantly.
        await InvokeAsync(StateHasChanged);
        await SaveWorkflowStateAsync();

        try
        {
            var agent = AgentProvider.GetDefaultAgent();
            var contexts = new List<RepoContext>();
            if (_workspace?.Links is not null)
            {
                foreach (var link in _workspace.Links)
                {
                    var repoPath = Path.Combine(_options.ReposRoot, link.RepositoryName);
                    if (Directory.Exists(repoPath))
                    {
                        try { contexts.Add(await agent.AnalyzeRepositoryAsync(repoPath, ct: default)); }
                        catch { }
                    }
                }
            }

            var reworked = await agent.ReworkPlanAsync(_ticket!, _plan, feedback, contexts);
            // Append a brief agent reply so the chat thread shows what changed.
            reworked.Comments.Add(new PlanComment(
                DateTimeOffset.UtcNow,
                "Agent",
                PlanCommentType.Note,
                BuildPlanDeltaSummary(_plan, reworked)));
            _plan = reworked;
            _workflow.Plan = _plan;
            _workflow.Steps[PipelineStep.Plan] = StepStatus.AwaitingApproval;
            // Re-post a fresh plan card to the chat so the user has an immediate, visible
            // artifact for the new plan version (otherwise they're staring at a stale chat
            // with no obvious next step).
            PostPlanCardToChat(isRework: true);
            await SaveWorkflowStateAsync();
        }
        catch (NotSupportedException)
        {
            _plan.Comments.Add(new PlanComment(
                DateTimeOffset.UtcNow,
                "Agent",
                PlanCommentType.Note,
                "This agent doesn't support plan rework. Switch to claude-cli in Settings."));
            _workflow.Steps[PipelineStep.Plan] = StepStatus.Warning;
            await SaveWorkflowStateAsync();
        }
        catch (Exception ex)
        {
            _plan.Comments.Add(new PlanComment(
                DateTimeOffset.UtcNow,
                "Agent",
                PlanCommentType.Note,
                $"Rework failed: {ex.Message}"));
            _workflow.Steps[PipelineStep.Plan] = StepStatus.Warning;
            await SaveWorkflowStateAsync();
            Toasts.Error($"Rework failed: {ex.Message}");
        }
        finally
        {
            _replanning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildPlanDeltaSummary(ImplementationPlan before, ImplementationPlan after)
    {
        var parts = new List<string>();
        if (after.Tasks.Count != before.Tasks.Count)
            parts.Add($"tasks: {before.Tasks.Count} → {after.Tasks.Count}");
        if (after.PlannedChanges.Count != before.PlannedChanges.Count)
            parts.Add($"planned changes: {before.PlannedChanges.Count} → {after.PlannedChanges.Count}");
        if (after.OpenQuestions.Count != before.OpenQuestions.Count)
            parts.Add($"open questions: {before.OpenQuestions.Count} → {after.OpenQuestions.Count}");
        return parts.Count == 0
            ? "Plan reworked. Review the new draft."
            : "Plan reworked — " + string.Join(", ", parts) + ".";
    }

    private bool _replanning;

    private void AddPlanTask()
    {
        if (_plan is null) return;
        var nextOrder = _plan.Tasks.Count > 0 ? _plan.Tasks.Max(t => t.Order) + 1 : 1;
        _plan.Tasks.Add(new PlannedTask(nextOrder, "", null, null));
    }

    private void UpdatePlanTask(int index, string description)
    {
        if (_plan is null || index < 0 || index >= _plan.Tasks.Count) return;
        var old = _plan.Tasks[index];
        _plan.Tasks[index] = old with { Description = description };
    }

    private void RemovePlanTask(int index)
    {
        if (_plan is null || index < 0 || index >= _plan.Tasks.Count) return;
        _plan.Tasks.RemoveAt(index);
        // Re-number
        for (var i = 0; i < _plan.Tasks.Count; i++)
        {
            _plan.Tasks[i] = _plan.Tasks[i] with { Order = i + 1 };
        }
    }

    private async Task RejectPlan()
    {
        if (_plan is null) return;
        _plan.Status = PlanStatus.Rejected;
        _plan.Comments.Add(new PlanComment(DateTimeOffset.UtcNow, "You", PlanCommentType.Rejection, string.IsNullOrWhiteSpace(_planComment) ? "Rejected." : _planComment));
        _workflow.Steps[PipelineStep.Plan] = StepStatus.Failed;
        _planComment = string.Empty;
        await SaveWorkflowStateAsync();
    }

