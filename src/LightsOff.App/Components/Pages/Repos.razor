@page "/repos"
@inject IRepositoryRegistry Registry
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Repositories</PageTitle>

<PageHeader Title="Repositories" Description="Git repos that can be linked to tickets. Cloned locally under ~/.lightsoff/repos.">
    <Actions>
        <button type="button" @onclick="() => _browseOpen = true"
                class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors">
            <Icon Name="search" Class="w-4 h-4" />
            Browse GitHub
        </button>
        <button type="button" @onclick="BeginAdd"
                class="inline-flex items-center gap-2 h-9 px-4 rounded-md border border-zinc-800 hover:bg-zinc-800/60 text-zinc-200 text-sm font-medium transition-colors">
            <Icon Name="plus" Class="w-4 h-4" />
            Add manually
        </button>
    </Actions>
</PageHeader>

@if (_repos is null)
{
    <div class="flex items-center gap-3 text-sm text-zinc-500 py-12 justify-center"><Spinner /> Loading…</div>
}
else if (_repos.Count == 0)
{
    <EmptyState IconName="folder"
                Title="No repositories yet"
                Description="Browse your GitHub account or add a repo manually by clone URL.">
        <div class="flex gap-2">
            <button type="button" @onclick="() => _browseOpen = true"
                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors">
                <Icon Name="search" Class="w-4 h-4" /> Browse GitHub
            </button>
        </div>
    </EmptyState>
}
else
{
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        @foreach (var repo in _repos)
        {
            <a href="@($"/repos/{repo.Name}")"
               class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 hover:bg-zinc-900/60 hover:border-zinc-700 transition-colors overflow-hidden group block">
                <div class="px-5 pt-4 pb-3">
                    <div class="flex items-start justify-between gap-3 mb-2">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-8 h-8 rounded-lg bg-zinc-800 flex items-center justify-center flex-shrink-0">
                                <Icon Name="folder" Class="w-4 h-4 text-zinc-400" />
                            </div>
                            <div class="min-w-0">
                                <div class="text-sm font-semibold text-zinc-100 truncate">@repo.Name</div>
                                <code class="text-[10px] text-zinc-500 font-mono truncate block">@repo.DefaultBranch</code>
                            </div>
                        </div>
                        <Icon Name="chevron-right" Class="w-4 h-4 text-zinc-700 group-hover:text-zinc-400 transition-colors mt-2 flex-shrink-0" />
                    </div>

                    <div class="text-xs text-zinc-500 font-mono truncate mt-2">@repo.CloneUrl</div>

                    @if (!string.IsNullOrEmpty(repo.Image))
                    {
                        <div class="flex items-center gap-1.5 mt-2">
                            <Icon Name="terminal" Class="w-3 h-3 text-zinc-600" />
                            <span class="text-[10px] text-zinc-500 font-mono truncate">@repo.Image</span>
                        </div>
                    }
                </div>
            </a>
        }
    </div>
    <div class="mt-4 text-xs text-zinc-500">@_repos.Count repositor@(_repos.Count == 1 ? "y" : "ies")</div>
}

<!-- Browse from GitHub modal -->
<GitHubBrowseModal @bind-Open="_browseOpen"
                   ExistingNames="@(_repos?.Select(r => r.Name).ToList() ?? new List<string>())"
                   OnRegister="RegisterFromGitHubAsync" />

<!-- Add/Edit modal -->
<Modal @bind-Open="_formOpen"
       Title="@(_editing ? "Edit repository" : "Add repository")"
       Description="@(_editing ? "Update clone URL, default branch, or container image." : "Provide a clone URL, default branch, and optional container image override.")">
    <ChildContent>
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Name</label>
                <input @bind="_form.Name" disabled="@_editing" placeholder="app"
                       class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors disabled:opacity-60 disabled:cursor-not-allowed" />
            </div>
            <div>
                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Clone URL</label>
                <input @bind="_form.CloneUrl" placeholder="git@@github.com:org/app.git"
                       class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors font-mono text-xs" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1.5">Default branch</label>
                    <input @bind="_form.DefaultBranch" placeholder="main"
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors font-mono text-xs" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-400 mb-1.5">Container image <span class="text-zinc-600">(optional)</span></label>
                    <input @bind="_form.Image" placeholder="node:20"
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-md px-3 py-2 text-sm placeholder:text-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/60 transition-colors font-mono text-xs" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_formError))
            {
                <Alert Kind="Alert.AlertKind.Error">@_formError</Alert>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" @onclick="() => _formOpen = false"
                class="inline-flex items-center gap-2 h-9 px-4 rounded-md text-sm text-zinc-300 hover:text-zinc-50 hover:bg-zinc-800/50 transition-colors">Cancel</button>
        <button type="button" @onclick="SubmitFormAsync" disabled="@_saving"
                class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors disabled:opacity-50">
            @if (_saving) { <Spinner /> <span>Saving…</span> }
            else { <Icon Name="check" Class="w-4 h-4" /> <span>@(_editing ? "Save" : "Add")</span> }
        </button>
    </Footer>
</Modal>

@code {
    private IReadOnlyList<Repository>? _repos;
    private bool _formOpen, _editing, _saving;
    private Repository _form = new();
    private string? _formError;
    private bool _browseOpen;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync() { _repos = await Registry.ListAsync(); }

    private void BeginAdd()
    {
        _editing = false;
        _form = new Repository { DefaultBranch = "main" };
        _formError = null;
        _formOpen = true;
    }

    private async Task SubmitFormAsync()
    {
        _formError = Validate(_form, _editing);
        if (_formError is not null) return;
        _saving = true;
        try
        {
            if (_editing) { await Registry.UpdateAsync(_form); Toasts.Success($"Updated {_form.Name}."); }
            else { await Registry.AddAsync(_form); Toasts.Success($"Added {_form.Name}."); }
            _formOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex) { _formError = ex.InnerException?.Message ?? ex.Message; }
        finally { _saving = false; }
    }

    private async Task RegisterFromGitHubAsync(IReadOnlyList<Repository> repos)
    {
        var added = 0; var skipped = 0; string? lastError = null;
        foreach (var repo in repos)
        {
            try { await Registry.AddAsync(repo); added++; }
            catch (Exception ex) { skipped++; lastError = ex.InnerException?.Message ?? ex.Message; }
        }
        await ReloadAsync();
        _browseOpen = false;
        if (added > 0 && skipped == 0) Toasts.Success($"Registered {added} repositor{(added == 1 ? "y" : "ies")}.");
        else if (added > 0) Toasts.Warning($"Registered {added}, skipped {skipped} ({lastError}).");
        else if (skipped > 0) Toasts.Error(lastError ?? "Failed.");
    }

    private static string? Validate(Repository repo, bool isEdit)
    {
        if (string.IsNullOrWhiteSpace(repo.Name)) return "Name is required.";
        if (!isEdit && repo.Name.Any(char.IsWhiteSpace)) return "No spaces in name.";
        if (string.IsNullOrWhiteSpace(repo.CloneUrl)) return "Clone URL is required.";
        if (string.IsNullOrWhiteSpace(repo.DefaultBranch)) return "Default branch is required.";
        return null;
    }
}
