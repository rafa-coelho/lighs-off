@page "/workspaces/{TicketKey}"
@using LightsOff.Core.Configuration
@using Microsoft.Extensions.Options
@inject IWorkspaceManager Manager
@inject IDockerService Docker
@inject IRepositoryRegistry Registry
@inject IOptions<LightsOffOptions> OptionsAccessor
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Workspace @TicketKey</PageTitle>

<nav class="flex items-center gap-2 text-sm text-zinc-500 mb-4">
    <a href="/workspaces" class="hover:text-zinc-200 inline-flex items-center gap-1.5">
        <Icon Name="arrow-left" Class="w-4 h-4" /> Workspaces
    </a>
    <span class="text-zinc-700">/</span>
    <span class="text-zinc-300"><code>@TicketKey</code></span>
</nav>

@if (_workspace is null && !_loading)
{
    <Alert Kind="Alert.AlertKind.Warning">Workspace <code>@TicketKey</code> not found.</Alert>
}
else if (_workspace is null)
{
    <div class="flex items-center gap-3 text-sm text-zinc-500 py-12 justify-center"><Spinner /> Loading…</div>
}
else
{
    <!-- Header -->
    <div class="flex items-start justify-between gap-4 mb-6">
        <div class="min-w-0">
            <div class="flex items-center gap-3 mb-1">
                <code class="text-2xl font-semibold text-emerald-400">@_workspace.TicketKey</code>
                <span class="@StatusBadge(_workspace.Status)">@_workspace.Status</span>
            </div>
            <h1 class="text-lg text-zinc-300">@_workspace.TicketSummary</h1>
            <div class="text-xs text-zinc-500 mt-1">Created @_workspace.CreatedAt.ToLocalTime().ToString("MMM dd yyyy, HH:mm")</div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
            <a href="@($"/tickets/{_workspace.TicketKey}")"
               class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium text-sm transition-colors">
                <Icon Name="ticket" Class="w-4 h-4" /> Open pipeline
            </a>
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-5">
        <!-- Container -->
        <section class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5">
            <h2 class="text-sm font-semibold mb-4 flex items-center gap-2">
                <Icon Name="terminal" Class="w-4 h-4 text-zinc-500" /> Container
            </h2>
            @if (!string.IsNullOrEmpty(_workspace.ContainerName))
            {
                <dl class="space-y-3 text-sm">
                    <div>
                        <dt class="text-xs uppercase tracking-wider text-zinc-500">Name</dt>
                        <dd class="text-zinc-200 font-mono text-xs mt-0.5">@_workspace.ContainerName</dd>
                    </div>
                    <div>
                        <dt class="text-xs uppercase tracking-wider text-zinc-500">ID</dt>
                        <dd class="text-zinc-400 font-mono text-[10px] mt-0.5 truncate">@_workspace.ContainerId</dd>
                    </div>
                    <div>
                        <dt class="text-xs uppercase tracking-wider text-zinc-500">Attach</dt>
                        <dd class="mt-1 flex items-center gap-2">
                            <code class="flex-1 text-xs font-mono text-emerald-300 bg-zinc-950 border border-zinc-800 rounded px-2 py-1.5 truncate">
                                docker exec -it @_workspace.ContainerName bash
                            </code>
                            <button type="button" @onclick="CopyAttachAsync"
                                    class="p-1.5 rounded-md text-zinc-500 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" title="Copy">
                                <Icon Name="copy" Class="w-4 h-4" />
                            </button>
                        </dd>
                    </div>
                </dl>

                <div class="flex gap-2 mt-4 pt-3 border-t border-zinc-800/60">
                    @if (_workspace.Status == WorkspaceStatus.Running)
                    {
                        <button type="button" @onclick="StopAsync" disabled="@_busy"
                                class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-100 transition-colors disabled:opacity-50">
                            @if (_busy) { <Spinner Class="w-3 h-3" /> } else { <Icon Name="stop" Class="w-3.5 h-3.5" /> }
                            Stop
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="StartAsync" disabled="@_busy"
                                class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-medium transition-colors disabled:opacity-50">
                            @if (_busy) { <Spinner Class="w-3 h-3" /> } else { <Icon Name="play" Class="w-3.5 h-3.5" /> }
                            Start
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="text-sm text-zinc-500">No container. Destroy and recreate with Docker running.</div>
            }
        </section>

        <!-- Repositories -->
        <section class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5">
            <h2 class="text-sm font-semibold mb-4 flex items-center gap-2">
                <Icon Name="folder" Class="w-4 h-4 text-zinc-500" /> Repositories (@_workspace.Links.Count)
            </h2>
            <div class="space-y-3">
                @foreach (var link in _workspace.Links)
                {
                    <div class="rounded-lg border border-zinc-800 bg-zinc-950/40 p-3">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-sm font-medium text-zinc-200">@link.RepositoryName</span>
                        </div>
                        <div class="flex items-center gap-3 text-xs text-zinc-500">
                            <div class="flex items-center gap-1 font-mono">
                                <span class="text-zinc-600">branch:</span>
                                <span class="text-emerald-400">@link.BranchName</span>
                            </div>
                        </div>
                        <div class="text-[10px] text-zinc-600 font-mono mt-1 truncate">
                            @Path.Combine(OptionsAccessor.Value.ReposRoot, link.RepositoryName)
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Paths + info -->
        <section class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5">
            <h2 class="text-sm font-semibold mb-4 flex items-center gap-2">
                <Icon Name="info" Class="w-4 h-4 text-zinc-500" /> Info
            </h2>
            <dl class="space-y-3 text-sm">
                <div>
                    <dt class="text-xs uppercase tracking-wider text-zinc-500">Workspace root</dt>
                    <dd class="text-zinc-400 font-mono text-[10px] mt-0.5 break-all">@_workspace.RootPath</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wider text-zinc-500">Repos root</dt>
                    <dd class="text-zinc-400 font-mono text-[10px] mt-0.5 break-all">@OptionsAccessor.Value.ReposRoot</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-wider text-zinc-500">Created</dt>
                    <dd class="text-zinc-300 text-xs mt-0.5">@_workspace.CreatedAt.ToLocalTime().ToString("f")</dd>
                </div>
            </dl>

            <div class="mt-4 pt-3 border-t border-zinc-800/60">
                <button type="button" @onclick="DestroyAsync" disabled="@_busy"
                        class="inline-flex items-center gap-1.5 h-8 px-3 rounded-md text-xs border border-red-900/70 hover:bg-red-950/40 text-red-300 transition-colors disabled:opacity-50">
                    @if (_busy) { <Spinner Class="w-3 h-3" /> } else { <Icon Name="trash" Class="w-3.5 h-3.5" /> }
                    Destroy workspace
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public string TicketKey { get; set; } = string.Empty;

    private Workspace? _workspace;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _workspace = await Manager.GetAsync(TicketKey);
        _loading = false;
    }

    private async Task StartAsync()
    {
        _busy = true;
        try { await Manager.StartAsync(TicketKey); Toasts.Success("Started."); _workspace = await Manager.GetAsync(TicketKey); }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task StopAsync()
    {
        _busy = true;
        try { await Manager.StopAsync(TicketKey); Toasts.Info("Stopped."); _workspace = await Manager.GetAsync(TicketKey); }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task DestroyAsync()
    {
        _busy = true;
        try { await Manager.DestroyAsync(TicketKey); Toasts.Info("Destroyed."); Nav.NavigateTo("/workspaces"); }
        catch (Exception ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task CopyAttachAsync()
    {
        if (_workspace?.ContainerName is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"docker exec -it {_workspace.ContainerName} bash"); Toasts.Success("Copied."); }
        catch { Toasts.Info($"docker exec -it {_workspace.ContainerName} bash"); }
    }

    private static string StatusBadge(WorkspaceStatus status)
    {
        var b = "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ";
        return b + status switch
        {
            WorkspaceStatus.Running => "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
            WorkspaceStatus.Stopped => "bg-zinc-800/70 text-zinc-400 border-zinc-700",
            _ => "bg-sky-500/10 text-sky-300 border-sky-500/30"
        };
    }
}
