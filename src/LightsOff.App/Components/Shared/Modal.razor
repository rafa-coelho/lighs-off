@* Headless modal — renders only when Open is true. Click backdrop to close, ESC via @onkeydown on the panel. *@

@if (Open)
{
    <div class="fixed inset-0 z-40 bg-black/70 backdrop-blur-sm animate-in fade-in"
         @onclick="HandleBackdropClick" @onclick:stopPropagation="true"></div>
    <div class="fixed inset-0 z-50 flex items-start md:items-center justify-center p-4 pointer-events-none"
         @onkeydown="HandleKeyDown">
        <div class="pointer-events-auto w-full @_widthClass rounded-xl border border-zinc-800 bg-zinc-950 shadow-2xl animate-in fade-in slide-in-from-bottom-4 focus:outline-none"
             @onclick:stopPropagation="true" tabindex="-1">
            <div class="px-6 py-4 border-b border-zinc-800/80 flex items-center justify-between">
                <div class="min-w-0">
                    <h2 class="font-semibold truncate">@Title</h2>
                    @if (!string.IsNullOrEmpty(Description))
                    {
                        <p class="text-xs text-zinc-500 mt-0.5 truncate">@Description</p>
                    }
                </div>
                <button type="button" @onclick="CloseAsync"
                        class="p-1.5 -mr-1.5 rounded-md text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800/60 transition-colors"
                        aria-label="Close">
                    <Icon Name="x" Class="w-4 h-4" />
                </button>
            </div>
            <div class="p-6">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <div class="px-6 py-4 border-t border-zinc-800/80 bg-zinc-900/30 rounded-b-xl flex justify-end gap-2">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public Size Width { get; set; } = Size.Medium;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    public enum Size { Small, Medium, Large }

    private string _widthClass => Width switch
    {
        Size.Small => "max-w-sm",
        Size.Large => "max-w-2xl",
        _ => "max-w-lg",
    };

    private Task HandleBackdropClick()
        => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        if (Open)
        {
            Open = false;
            await OpenChanged.InvokeAsync(false);
        }
    }
}
