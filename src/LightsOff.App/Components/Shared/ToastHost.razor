@implements IDisposable
@inject ToastService Toasts

<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 w-[22rem] pointer-events-none">
    @foreach (var toast in Toasts.Toasts)
    {
        <div class="@KindClasses(toast.Kind) pointer-events-auto border rounded-lg shadow-lg px-4 py-3 flex items-start gap-3 animate-in fade-in slide-in-from-bottom-2"
             @key="toast.Id">
            <div class="flex-shrink-0 mt-0.5">@Icon(toast.Kind)</div>
            <div class="flex-1 text-sm leading-relaxed">@toast.Message</div>
            <button class="text-zinc-500 hover:text-zinc-200 transition-colors" @onclick="() => Toasts.Dismiss(toast.Id)" aria-label="Dismiss">
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.28 3.22a.75.75 0 0 0-1.06 1.06L8.94 10l-5.72 5.72a.75.75 0 1 0 1.06 1.06L10 11.06l5.72 5.72a.75.75 0 1 0 1.06-1.06L11.06 10l5.72-5.72a.75.75 0 0 0-1.06-1.06L10 8.94 4.28 3.22Z" clip-rule="evenodd" /></svg>
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Toasts.Changed += HandleChanged;
    }

    private async void HandleChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Toasts.Changed -= HandleChanged;
    }

    private static string KindClasses(ToastKind kind) => kind switch
    {
        ToastKind.Success => "bg-emerald-950/90 border-emerald-800 text-emerald-100",
        ToastKind.Warning => "bg-amber-950/90 border-amber-800 text-amber-100",
        ToastKind.Error => "bg-red-950/90 border-red-800 text-red-100",
        _ => "bg-zinc-900/95 border-zinc-700 text-zinc-100"
    };

    private static RenderFragment Icon(ToastKind kind) => builder =>
    {
        var path = kind switch
        {
            ToastKind.Success => "M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z",
            ToastKind.Warning => "M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z",
            ToastKind.Error => "M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z",
            _ => "M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm-1 3a.75.75 0 0 0-.75.75v3.5a.75.75 0 0 0 1.5 0v-3.5A.75.75 0 0 0 10 9Z"
        };
        builder.AddMarkupContent(0, $"<svg class=\"w-5 h-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\"><path fill-rule=\"evenodd\" d=\"{path}\" clip-rule=\"evenodd\" /></svg>");
    };
}
