@* Compact "artifact" card rendered inline in the chat thread when the agent produces a plan.
   Click → opens the side panel with the full markdown. *@

@using LightsOff.Core.Domain

<button type="button" @onclick="OnClick"
        class="block w-full text-left mt-2 rounded-lg border border-zinc-700 hover:border-emerald-500/50 hover:bg-zinc-900/60 bg-zinc-950/60 transition-all p-3 group">
    <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-md bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center flex-shrink-0">
            <Icon Name="ticket" Class="w-4 h-4 text-emerald-300" />
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                <span class="text-sm font-semibold text-zinc-100">Implementation plan</span>
                <span class="@StatusBadge(Plan.Status)">@Plan.Status</span>
                @if (Plan.OpenQuestions.Count > 0)
                {
                    <span class="text-[10px] text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-1.5 py-0.5">
                        @Plan.OpenQuestions.Count open question@(Plan.OpenQuestions.Count == 1 ? "" : "s")
                    </span>
                }
            </div>
            <div class="text-[11px] text-zinc-500 mb-1.5">
                @Plan.Tasks.Count task@(Plan.Tasks.Count == 1 ? "" : "s") · @Plan.PlannedChanges.Count file change@(Plan.PlannedChanges.Count == 1 ? "" : "s") · @Plan.AgentUsed
            </div>
            @if (!string.IsNullOrEmpty(Plan.Approach))
            {
                <div class="text-xs text-zinc-400 line-clamp-2 leading-relaxed">@FirstSentence(Plan.Approach)</div>
            }
            <div class="text-[11px] text-emerald-400 mt-2 inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                Open full plan
                <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor"><path d="M5.646 4.646a.5.5 0 0 1 .708 0l4.5 4.5a.5.5 0 0 1 0 .708l-4.5 4.5a.5.5 0 0 1-.708-.708L9.793 9 5.646 4.854a.5.5 0 0 1 0-.708Z"/></svg>
            </div>
        </div>
    </div>
</button>

@code {
    [Parameter, EditorRequired] public ImplementationPlan Plan { get; set; } = null!;
    [Parameter] public EventCallback OnClick { get; set; }

    private static string StatusBadge(PlanStatus s) => s switch
    {
        PlanStatus.Approved          => "text-[10px] text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 rounded px-1.5 py-0.5",
        PlanStatus.AwaitingApproval  => "text-[10px] text-sky-300 bg-sky-500/10 border border-sky-500/30 rounded px-1.5 py-0.5",
        PlanStatus.ChangesRequested  => "text-[10px] text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-1.5 py-0.5",
        PlanStatus.Rejected          => "text-[10px] text-red-300 bg-red-500/10 border border-red-500/30 rounded px-1.5 py-0.5",
        _                            => "text-[10px] text-zinc-300 bg-zinc-800 border border-zinc-700 rounded px-1.5 py-0.5"
    };

    private static string FirstSentence(string s)
    {
        var i = s.IndexOfAny(new[] { '.', '\n' });
        if (i < 0 || i > 200) return s.Length > 200 ? s[..200] + "…" : s;
        return s[..(i + 1)];
    }
}
