@* Slide-in artifact panel showing the full rendered plan markdown. Approve/Reject lives at the
   bottom — but ONLY when the plan has no open questions and the chat has no pending question
   batch. Otherwise the user must finish answering before they can act on the plan. *@

@using LightsOff.Core.Domain
@using LightsOff.App.Services
@inject MarkdownRenderer Markdown

@if (IsOpen && Plan is not null)
{
    <div class="fixed inset-0 z-40 flex justify-end" @onclick="OnClose">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm animate-fade-in"></div>
        <aside class="relative z-50 w-full max-w-3xl h-full bg-zinc-950 border-l border-zinc-800 shadow-2xl flex flex-col animate-slide-in-right"
               @onclick:stopPropagation="true">
            <header class="flex items-center justify-between px-6 py-4 border-b border-zinc-800 flex-shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-9 h-9 rounded-md bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center flex-shrink-0">
                        <Icon Name="ticket" Class="w-4 h-4 text-emerald-300" />
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-base font-semibold text-zinc-100 truncate">Implementation plan</h2>
                        <div class="text-[11px] text-zinc-500 flex items-center gap-2">
                            <span class="@StatusBadge(Plan.Status)">@Plan.Status</span>
                            <span>@Plan.Tasks.Count task@(Plan.Tasks.Count == 1 ? "" : "s") · @Plan.PlannedChanges.Count file change@(Plan.PlannedChanges.Count == 1 ? "" : "s")</span>
                        </div>
                    </div>
                </div>
                <button type="button" @onclick="OnClose"
                        class="p-2 rounded text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800 transition-colors flex-shrink-0"
                        aria-label="Close">
                    <Icon Name="x" Class="w-5 h-5" />
                </button>
            </header>

            <div class="flex-1 overflow-auto px-6 py-5">
                <div class="md-content">
                    @((MarkupString)Markdown.ToHtml(MarkdownRenderer.PlanToMarkdown(Plan)))
                </div>
            </div>

            @if (Plan.NeedsAction)
            {
                <footer class="border-t border-zinc-800 px-6 py-4 flex-shrink-0 bg-zinc-950/80 backdrop-blur">
                    @if (HasPendingQuestions || Plan.OpenQuestions.Count > 0)
                    {
                        <div class="flex items-center gap-2 text-xs text-amber-300/90">
                            <Icon Name="alert" Class="w-4 h-4 flex-shrink-0" />
                            <span>Answer the open questions in the chat before approving this plan.</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="OnApprove" disabled="@Disabled"
                                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md bg-emerald-500 hover:bg-emerald-400 text-emerald-950 font-semibold text-sm transition-all shadow-sm hover:shadow-emerald-500/30 disabled:opacity-40 disabled:cursor-not-allowed">
                                <Icon Name="check" Class="w-4 h-4" /> Approve plan
                            </button>
                            <button type="button" @onclick="OnReject" disabled="@Disabled"
                                    class="inline-flex items-center gap-2 h-9 px-4 rounded-md border border-red-900/70 hover:bg-red-950/40 text-red-300 text-sm font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                                Reject
                            </button>
                        </div>
                    }
                </footer>
            }
        </aside>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ImplementationPlan? Plan { get; set; }
    [Parameter] public bool HasPendingQuestions { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnApprove { get; set; }
    [Parameter] public EventCallback OnReject { get; set; }

    private static string StatusBadge(PlanStatus s) => s switch
    {
        PlanStatus.Approved          => "text-[10px] text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 rounded px-1.5 py-0.5",
        PlanStatus.AwaitingApproval  => "text-[10px] text-sky-300 bg-sky-500/10 border border-sky-500/30 rounded px-1.5 py-0.5",
        PlanStatus.ChangesRequested  => "text-[10px] text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-1.5 py-0.5",
        PlanStatus.Rejected          => "text-[10px] text-red-300 bg-red-500/10 border border-red-500/30 rounded px-1.5 py-0.5",
        _                            => "text-[10px] text-zinc-300 bg-zinc-800 border border-zinc-700 rounded px-1.5 py-0.5"
    };
}
