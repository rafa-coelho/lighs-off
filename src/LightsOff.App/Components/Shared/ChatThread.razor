@* ChatGPT-style conversation: full-width rows, avatar + name + content, generous typography.
   Markdown for agent replies. Composer pinned at the bottom with a circular send button.

   The parent owns the message list and the send callback; this component is purely
   presentational + input. Auto-scrolls smoothly to the latest message on update.

   When there is an active question batch, the ChatQuestionCard renders between the
   thread and the composer (same level, full width) — not inline inside a bubble. *@

@using LightsOff.Core.Domain
@using LightsOff.App.Services
@using System.Text.Json
@inject MarkdownRenderer Markdown
@inject IJSRuntime JS

@{
    QuestionsPayload? activePayload = null;
    if (ActiveQuestionsBatchId is not null)
    {
        foreach (var m in Messages)
        {
            if (m.Attachment is { Kind: ChatAttachment.KindQuestions, PayloadJson: { } pj })
            {
                var p = TryDeserializeQuestions(pj);
                if (p?.BatchId == ActiveQuestionsBatchId && !p.Closed)
                { activePayload = p; break; }
            }
        }
    }
}

<div class="rounded-xl border border-zinc-800 bg-zinc-950/40 overflow-hidden flex flex-col">

    <!-- Scrolling thread -->
    <div id="@_scrollId" class="overflow-auto px-4 sm:px-6 py-5 scroll-smooth" style="max-height: 60vh; min-height: 240px;">
        @if (Messages.Count == 0 && !IsPending)
        {
            <div class="flex flex-col items-center justify-center text-center py-10 px-4">
                <div class="w-11 h-11 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mb-3">
                    <Icon Name="play" Class="w-5 h-5 text-emerald-300" />
                </div>
                <div class="text-sm text-zinc-200 font-semibold mb-1">@EmptyTitle</div>
                <div class="text-xs text-zinc-500 max-w-md leading-relaxed">@EmptyHint</div>
            </div>
        }
        else
        {
            <div class="space-y-6">
                @foreach (var m in Messages)
                {
                    @RenderMessage(m)
                }
                @if (IsPending)
                {
                    @RenderPending()
                }
            </div>
        }
    </div>

    <!-- Question card: rendered above the composer when there is an active batch -->
    @if (activePayload is not null)
    {
        <ChatQuestionCard Payload="activePayload"
                          Disabled="false"
                          OnSubmit="@(args => OnQuestionSubmit.InvokeAsync((activePayload.BatchId, args.Index, args.Answer)))"
                          OnSkipped="@(idx => OnQuestionSkipped.InvokeAsync((activePayload.BatchId, idx)))"
                          OnDismiss="@(() => OnQuestionsDismissed.InvokeAsync(activePayload.BatchId))" />
    }

    <!-- Composer -->
    <div class="border-t border-zinc-800 bg-zinc-950/80 backdrop-blur p-3 @(activePayload is not null ? "opacity-40 pointer-events-none select-none" : "")">
        <div class="rounded-xl border border-zinc-800 focus-within:border-emerald-500/60 focus-within:ring-2 focus-within:ring-emerald-500/20 bg-zinc-950 transition-all">
            <textarea @bind="_draft" @bind:event="oninput" @onkeydown="OnKeyDownAsync"
                      placeholder="@Placeholder"
                      rows="2"
                      disabled="@(IsPending || activePayload is not null)"
                      class="w-full bg-transparent px-4 py-3 text-sm text-zinc-100 placeholder:text-zinc-600 focus:outline-none resize-none disabled:opacity-50"
                      style="min-height: 56px; max-height: 240px;"></textarea>
            <div class="flex items-center justify-between px-3 pb-2 pt-1">
                <div class="text-[10px] text-zinc-600">
                    <kbd class="px-1.5 py-0.5 rounded border border-zinc-800 bg-zinc-900 text-zinc-400 font-mono">Enter</kbd>
                    to send · <kbd class="px-1.5 py-0.5 rounded border border-zinc-800 bg-zinc-900 text-zinc-400 font-mono">Shift+Enter</kbd>
                    for newline
                </div>
                <button type="button" @onclick="SendAsync" disabled="@(IsPending || activePayload is not null || string.IsNullOrWhiteSpace(_draft))"
                        class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-emerald-500 hover:bg-emerald-400 text-emerald-950 transition-all shadow-sm hover:shadow-emerald-500/30 disabled:opacity-30 disabled:cursor-not-allowed"
                        aria-label="Send message">
                    <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M2.4 1.5a.75.75 0 0 0-1.05.85l1.65 5.4-1.65 5.4a.75.75 0 0 0 1.05.85l12-6a.75.75 0 0 0 0-1.34l-12-6.16Zm.86 6.18L2.4 4.4l9.45 4.85H5.4a.5.5 0 0 0 0 1h6.45L2.4 15.1l.86-3.32Z"/></svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChatMessage> Messages { get; set; } = Array.Empty<ChatMessage>();
    [Parameter, EditorRequired] public EventCallback<string> OnSend { get; set; }
    [Parameter] public bool IsPending { get; set; }
    [Parameter] public string Title { get; set; } = "Conversation";
    [Parameter] public string Placeholder { get; set; } = "Type your message…";
    [Parameter] public string EmptyTitle { get; set; } = "Start the conversation";
    [Parameter] public string EmptyHint { get; set; } = "Ask questions, push back, or clarify intent.";
    [Parameter] public string PendingHint { get; set; } = "thinking…";

    [Parameter] public string? ActiveQuestionsBatchId { get; set; }
    [Parameter] public EventCallback<(string BatchId, int Index, string Answer)> OnQuestionSubmit { get; set; }
    [Parameter] public EventCallback<(string BatchId, int Index)> OnQuestionSkipped { get; set; }
    [Parameter] public EventCallback<string> OnQuestionsDismissed { get; set; }

    // Plan artifact rendering — current plan reference used by inline KindPlan cards.
    [Parameter] public ImplementationPlan? Plan { get; set; }
    [Parameter] public EventCallback OnOpenPlan { get; set; }

    private string _draft = string.Empty;
    private readonly string _scrollId = "chat-" + Guid.NewGuid().ToString("N")[..8];
    private int _lastMessageCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Messages.Count != _lastMessageCount || IsPending)
        {
            _lastMessageCount = Messages.Count;
            try { await JS.InvokeVoidAsync("eval", $"document.getElementById('{_scrollId}')?.scrollTo({{top: 99999, behavior: 'smooth'}})"); }
            catch { }
        }
    }

    private RenderFragment RenderMessage(ChatMessage m) => __builder =>
    {
        var isUser = m.Role == ChatMessage.RoleUser;
        var isSystem = m.Role == ChatMessage.RoleSystem;
        var time = m.At.ToLocalTime().ToString("HH:mm");

        if (isSystem)
        {
            <div class="flex justify-center chat-fade-in">
                <div class="text-[11px] text-zinc-500 italic px-3 py-1 rounded-full bg-zinc-900/60 border border-zinc-800/60">
                    @m.Content
                </div>
            </div>
        }
        else
        {
            <div class="flex items-start gap-3 chat-fade-in">
                <div class="@($"w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 {AvatarClass(m.Role)}")">
                    @if (isUser)
                    {
                        <span class="text-xs font-semibold text-emerald-100">You</span>
                    }
                    else
                    {
                        <Icon Name="play" Class="w-3.5 h-3.5 text-emerald-300" />
                    }
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-2 mb-1">
                        <span class="text-sm font-semibold @NameClass(m.Role)">@(isUser ? "You" : "Agent")</span>
                        <span class="text-[10px] text-zinc-600">@time</span>
                    </div>
                    @if (isUser)
                    {
                        <div class="text-sm text-zinc-200 whitespace-pre-wrap break-words leading-relaxed">@m.Content</div>
                    }
                    else
                    {
                        <div class="md-content md-content--compact">
                            @((MarkupString)Markdown.ToHtml(m.Content))
                        </div>
                    }

                    @* Closed question batches render a compact summary in-thread. Active ones render above the composer. *@
                    @if (!isUser && m.Attachment is { Kind: ChatAttachment.KindQuestions, PayloadJson: { } json })
                    {
                        var p = TryDeserializeQuestions(json);
                        if (p?.Closed == true)
                        {
                            var answered = p.Answers.Count(a => !string.IsNullOrEmpty(a.Value));
                            var skipped  = p.Answers.Count(a =>  string.IsNullOrEmpty(a.Value));
                            <div class="mt-2 text-[11px] text-zinc-500 italic">
                                @answered answered, @skipped skipped (of @p.Questions.Count)
                            </div>
                        }
                    }

                    @* Plan artifact card — agent-generated implementation plan. Click opens side panel. *@
                    @if (!isUser && m.Attachment is { Kind: ChatAttachment.KindPlan } && Plan is not null)
                    {
                        <ChatPlanCard Plan="Plan" OnClick="@(() => OnOpenPlan.InvokeAsync())" />
                    }
                </div>
            </div>
        }
    };

    private RenderFragment RenderPending() => __builder =>
    {
        <div class="flex items-start gap-3 chat-fade-in">
            <div class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon Name="play" Class="w-3.5 h-3.5 text-emerald-300" />
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2 mb-1">
                    <span class="text-sm font-semibold text-zinc-300">Agent</span>
                </div>
                <div class="flex items-center gap-2 text-sm text-zinc-500">
                    <span class="inline-flex gap-1">
                        <span class="w-1.5 h-1.5 bg-zinc-500 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
                        <span class="w-1.5 h-1.5 bg-zinc-500 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
                        <span class="w-1.5 h-1.5 bg-zinc-500 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
                    </span>
                    <span class="italic">@PendingHint</span>
                </div>
            </div>
        </div>
    };

    private static string AvatarClass(string role) => role switch
    {
        ChatMessage.RoleUser  => "bg-emerald-500/20 border border-emerald-400/40",
        ChatMessage.RoleAgent => "bg-emerald-500/10 border border-emerald-500/30",
        _                     => "bg-zinc-800/60 border border-zinc-700"
    };

    private static string NameClass(string role) => role switch
    {
        ChatMessage.RoleUser  => "text-emerald-200",
        ChatMessage.RoleAgent => "text-zinc-200",
        _                     => "text-zinc-400"
    };

    private static readonly JsonSerializerOptions _webOpts = new(JsonSerializerDefaults.Web);

    private static QuestionsPayload? TryDeserializeQuestions(string? json)
    {
        if (string.IsNullOrEmpty(json)) return null;
        try { return JsonSerializer.Deserialize<QuestionsPayload>(json, _webOpts); }
        catch { return null; }
    }

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        if (string.IsNullOrEmpty(text) || IsPending) return;
        _draft = string.Empty;
        await OnSend.InvokeAsync(text);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }
}
