@using LightsOff.Core.Domain

<div class="flex items-center gap-1 mb-6">
    @foreach (var step in _visibleSteps)
    {
        var status = StatusFor(step);
        var unlocked = State.IsStepUnlocked(step);
        var active = step == ActiveStep;

        <button type="button"
                disabled="@(!unlocked)"
                @onclick="() => OnStepClick.InvokeAsync(step)"
                class="@StepClass(status, active, unlocked)">
            <span class="flex items-center justify-center w-6 h-6 rounded-full mr-2 text-xs font-bold @StepCircleClass(status)">
                @StatusIcon(status)
            </span>
            <span class="text-xs font-medium">@DisplayName(step)</span>
        </button>

        @if (step != _visibleSteps[^1])
        {
            <div class="w-6 h-px @(status is StepStatus.Passed or StepStatus.Warning ? "bg-emerald-500/50" : "bg-zinc-800")"></div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public WorkflowState State { get; set; } = new();
    [Parameter] public PipelineStep ActiveStep { get; set; } = PipelineStep.Plan;
    [Parameter] public EventCallback<PipelineStep> OnStepClick { get; set; }

    // Analyze is folded into Plan and Review is folded into Validate — single iteration surface
    // each. Hidden steps still tick through workflow state for backwards-compat with persisted
    // workflows, just not surfaced here.
    private static readonly PipelineStep[] _visibleSteps =
    {
        PipelineStep.Plan,
        PipelineStep.Implement,
        PipelineStep.Validate,
        PipelineStep.Submit
    };

    /// <summary>
    /// Roll up Analyze status into Plan and Review status into Validate so the merged step
    /// reflects the worst of its two underlying states.
    /// </summary>
    private StepStatus StatusFor(PipelineStep step) => step switch
    {
        PipelineStep.Plan => Worse(
            State.Steps.GetValueOrDefault(PipelineStep.Analyze, StepStatus.Pending),
            State.Steps.GetValueOrDefault(PipelineStep.Plan, StepStatus.Pending)),
        PipelineStep.Validate => Worse(
            State.Steps.GetValueOrDefault(PipelineStep.Validate, StepStatus.Pending),
            State.Steps.GetValueOrDefault(PipelineStep.Review, StepStatus.Pending)),
        _ => State.Steps.GetValueOrDefault(step, StepStatus.Pending)
    };

    private static StepStatus Worse(StepStatus a, StepStatus b)
    {
        // Status priority: Failed beats Running beats AwaitingApproval beats Warning beats
        // Pending beats Skipped beats Passed. Pick the worse of the two.
        static int Rank(StepStatus s) => s switch
        {
            StepStatus.Failed => 6,
            StepStatus.Running => 5,
            StepStatus.AwaitingApproval => 4,
            StepStatus.Warning => 3,
            StepStatus.Pending => 2,
            StepStatus.Skipped => 1,
            StepStatus.Passed => 0,
            _ => 0
        };
        return Rank(a) >= Rank(b) ? a : b;
    }

    private static string DisplayName(PipelineStep step) => step switch
    {
        PipelineStep.Plan => "Understand & Plan",
        PipelineStep.Validate => "Validate",
        _ => step.ToString()
    };

    private static string StepClass(StepStatus status, bool active, bool unlocked)
    {
        var baseClass = "inline-flex items-center px-3 py-2 rounded-lg text-sm transition-colors ";
        if (!unlocked) return baseClass + "opacity-40 cursor-not-allowed bg-zinc-950";
        if (active) return baseClass + "bg-zinc-800 border border-zinc-700 cursor-pointer";
        return baseClass + "hover:bg-zinc-900/60 cursor-pointer";
    }

    private static string StepCircleClass(StepStatus status) => status switch
    {
        StepStatus.Passed => "bg-emerald-500/20 text-emerald-300",
        StepStatus.Warning => "bg-amber-500/20 text-amber-300",
        StepStatus.Failed => "bg-red-500/20 text-red-300",
        StepStatus.Running => "bg-sky-500/20 text-sky-300",
        StepStatus.AwaitingApproval => "bg-amber-500/20 text-amber-300",
        _ => "bg-zinc-800 text-zinc-500"
    };

    private static string StatusIcon(StepStatus status) => status switch
    {
        StepStatus.Passed => "✓",
        StepStatus.Warning => "!",
        StepStatus.Failed => "✗",
        StepStatus.Running => "…",
        StepStatus.AwaitingApproval => "?",
        _ => "·"
    };
}
